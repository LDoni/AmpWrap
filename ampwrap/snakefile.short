# functions for inputs
def getOriginalReadFilesDict(wildcards, df=sample_df):
    rows = df[(df["Sample"] == wildcards.sample) & (df["Run"] == wildcards.run)]
    out = {f"r{row['Direction']}": row["Path"] for _, row in rows.iterrows()}
    return out


def getReadFilesDict(wildcards):
    return {
        "r1": f"{output_dir}/{wildcards.run}/figaro_inp/{wildcards.sample}_R1.{file_extension}",
        "r2": f"{output_dir}/{wildcards.run}/figaro_inp/{wildcards.sample}_R2.{file_extension}",
    }


def stable_seed(sample, run):
    text = f"{run}:{sample}"
    return sum((idx + 1) * ord(ch) for idx, ch in enumerate(text)) % 100000 + 11


def mergeRuns(wildcards,runs=runs):
    files = [f"{output_dir}/{run}/intermediate/asv_table.rds" for run in runs]
    return files

def trackReadsDict(wildcards,runs=runs):
    chimerae_dir = f"{runs[0]}/intermediate"
    if is_multirun: chimerae_dir = "all_runs/intermediate"

    d = {"summaries": [f"{output_dir}/{run}/intermediate/dada2_filtered/filter_summary.tsv" for run in runs],
         "fwd":[f"{output_dir}/{run}/intermediate/dada_fwd.rds" for run in runs],
         "rev":[f"{output_dir}/{run}/intermediate/dada_rev.rds" for run in runs],
         "merged":[f"{output_dir}/{run}/intermediate/merged_asvs.rds" for run in runs],
         "chimera": f"{output_dir}/{chimerae_dir}/no_chimera_asvs.rds"
         }
    return(d)

def figaro_input(wc):
    return [f"{output_dir}/{wc.run}/intermediate/figaro/trimParameters.json"] if USE_FIGARO else []

def figaro_arg(wc):
    return f"{output_dir}/{wc.run}/intermediate/figaro/trimParameters.json" if USE_FIGARO else "NONE"



rule all:
    input:
        expand(
            "{output_dir}/{run}/intermediate/figaro/trimParameters.json",
            output_dir=[config['output_dir']],
            run=runs
        ) if dry_run_tune else
        [
            # Figaro input
            *[
                f"{config['output_dir']}/{c['Run']}/figaro_inp/{c['Sample']}_R{idx}.{file_extension}"
                for c in combo
                for idx in indices
            ],

            # FastQC initial
            *[
                f"{output_dir}/{c['Run']}/QC/raw_qc_initial/{c['Sample']}_R{index}_fastqc.html"
                for index in ["1","2"]
                for c in combo
            ],
            expand("{output_dir}/{run}/QC/raw_qc_initial/multiqc_report.html",output_dir=[config['output_dir']],run=runs),

            # Cutadapt
            *[
                f"{config['output_dir']}/{c['Run']}/intermediate/cutadapt/{c['Sample']}_trimmed_R{idx}.fq.gz"
                for c in combo
                for idx in indices
            ],
            *[
                f"{config['output_dir']}/{c['Run']}/intermediate/cutadapt/cutadapt_primer_trimming_stats.txt"
                 for c in combo
             ],
            *[
                f"{config['output_dir']}/{c['Run']}/intermediate/cutadapt/cutadapt_summary.log"
                 for c in combo
             ],
            *[
                f"{config['output_dir']}/{c['Run']}/QC/raw_qc_post_cutadapt/{c['Sample']}_trimmed_R{idx}_fastqc.html"
                for c in combo
                for idx in indices
            ],

            expand("{output_dir}/{run}/QC/raw_qc_post_cutadapt/multiqc_report.html",output_dir=[config['output_dir']],run=runs),

            *[
                 f"{config['output_dir']}/{c['Run']}/intermediate/figaro/trimParameters.json"
                 for c in combo if USE_FIGARO
            ],

            # Dada2
            expand("{output_dir}/{run}/intermediate/dada2_filtered/checkout.filter",output_dir=output_dir,run=runs),
            expand("{output_dir}/{run}/intermediate/dada2_error_learning/err_{direction}_reads.rds", output_dir=output_dir,run=runs,direction=["forward", "reverse"]),
            expand("{output_dir}/{run}/intermediate/merged_asvs.rds", output_dir=output_dir,run=runs),
            expand("{output_dir}/{run}/intermediate/asv_table.rds", output_dir=output_dir,run=runs),
            expand("{output_dir}/{run}/intermediate/dada2_filtered/filter_summary.tsv",output_dir=output_dir,run=runs),
            expand("{output_dir}/{run}/intermediate/dada_fwd.rds",output_dir=output_dir,run=runs),
            expand("{output_dir}/{run}/intermediate/dada_rev.rds",output_dir=output_dir,run=runs),            

            f"{output_dir}/all_runs/merged_asv_table.rds" if is_multirun else [], 
            f"{output_dir}/all_runs/no_chimera_asvs.rds" if is_multirun else expand("{output_dir}/{run}/intermediate/no_chimera_asvs.rds",output_dir=output_dir,run=runs),
            f"{output_dir}/{chimerae_dir}/asv_length_filter.tsv",
            f"{db_dir}/dada2/{out_name}",
            f"{db_dir}/dada2/{species_out_name}" if species_assignment and species_out_name else [],
            f"{output_dir}/results/ASVs.fa",
            f"{output_dir}/results/read-count-tracking.tsv",
            f"{output_dir}/results/final_report.txt",
        ]


rule input_symlink:
    input: lambda wildcards: getOriginalReadFilesDict(wildcards)[f"r{wildcards.index}"]
    output: f"{output_dir}/{{run}}/figaro_inp/{{sample}}_R{{index,[^\._]+}}.{file_extension}"
    log: f"{logs_dir}/input_symlink/{{run}}/{{sample}}_R{{index}}.log"
    threads: rule_threads("input_symlink")
    params:
        max_reads=max_reads_per_sample,
        sample_seed=lambda wildcards: stable_seed(wildcards.sample, wildcards.run)
    shell:
        r"""
        mkdir -p $(dirname {log})
        mkdir -p $(dirname {output})
        SRC=$(realpath {input})
        TARGET=$(realpath -m {output})

        TOTAL_READS=$(seqkit stats -j {threads} -T "$SRC" | awk 'NR==2 {{print $4}}')
        if [ -z "$TOTAL_READS" ]; then
            echo "Unable to determine read count for $SRC" > {log}
            exit 1
        fi

        MAX_READS_VALUE="{params.max_reads}"

        if [ "$MAX_READS_VALUE" -gt 0 ]; then
            if [ "$TOTAL_READS" -le "$MAX_READS_VALUE" ]; then
                ln -sf "$SRC" "$TARGET"
                {{
                    echo "mode=symlink"
                    echo "source=$SRC"
                    echo "target=$TARGET"
                    echo "reads_total=$TOTAL_READS"
                    echo "reads_kept=$TOTAL_READS"
                }} > {log}
            else
                PROPORTION=$(awk -v max="$MAX_READS_VALUE" -v total="$TOTAL_READS" 'BEGIN {{printf "%.12f", max/total}}')
                seqkit sample -2 -p "$PROPORTION" -s {params.sample_seed} "$SRC" -o "$TARGET" > /dev/null
                KEPT_READS=$(seqkit stats -j {threads} -T "$TARGET" | awk 'NR==2 {{print $4}}')
                {{
                    echo "mode=downsample"
                    echo "source=$SRC"
                    echo "target=$TARGET"
                    echo "reads_total=$TOTAL_READS"
                    echo "reads_requested_max=$MAX_READS_VALUE"
                    echo "reads_kept=$KEPT_READS"
                    echo "seed={params.sample_seed}"
                }} > {log}
            fi
        else
            ln -sf "$SRC" "$TARGET"
            {{
                echo "mode=symlink"
                echo "source=$SRC"
                echo "target=$TARGET"
            }} > {log}
        fi
        """

rule cutadapt:
     input:
        r1=lambda wc: getReadFilesDict(wc)["r1"],
        r2=lambda wc: getReadFilesDict(wc)["r2"]
     output:
         r1_trimmed = "{output_dir}/{run}/intermediate/cutadapt/{sample}_trimmed_R1.fq.gz",
         r2_trimmed = "{output_dir}/{run}/intermediate/cutadapt/{sample}_trimmed_R2.fq.gz"
     log:
         "{output_dir}/{run}/intermediate/cutadapt/{sample}_cutadapt.log"
     threads: rule_threads("cutadapt")
     params:
         forward_primer = forward_primer,
         reverse_primer = reverse_primer,
         trim_primers_dada2 = trim_primers_dada2,
         forward_primer_length = forward_primer_length,
         reverse_primer_length = reverse_primer_length
     shell:
         """
         mkdir -p {output_dir}/{wildcards.run}/intermediate/cutadapt

         if [ "{params.trim_primers_dada2}" = "True" ]; then
         ln -sf "$(realpath {input.r1})" {output.r1_trimmed}
         ln -sf "$(realpath {input.r2})" {output.r2_trimmed}
         printf "mode=bypass_for_dada2_trim\\nsource_r1=%s\\nsource_r2=%s\\n" "{input.r1}" "{input.r2}" > {log}
         else
         cutadapt -j {threads} -g "^{params.forward_primer}" -G "^{params.reverse_primer}" {discard_untrimmed} \
                  -o {output.r1_trimmed} -p {output.r2_trimmed} \
                  {input.r1} {input.r2} > {log} 2>&1
         fi
         """

rule fastqc_initial:
     input: f"{output_dir}/{{run}}/figaro_inp/{{sample}}_R{{index}}.{file_extension}"
     output:
         f"{output_dir}/{{run}}/QC/raw_qc_initial/{{sample}}_R{{index,[^\._]}}_fastqc.html"
     log:
         f"{logs_dir}/fastqc_initial/{{run}}/{{sample}}_R{{index}}.log"
     threads: rule_threads("fastqc")
     shell:
         """
         mkdir -p {output_dir}/{wildcards.run}/QC/raw_qc_initial
         mkdir -p $(dirname {log})
         fastqc {input} -o $(dirname {output}) -t {threads} > {log} 2>&1
         """


rule multiqc_initial:
    input:
        lambda wildcards: [
            f"{output_dir}/{c['Run']}/QC/raw_qc_initial/{c['Sample']}_R{index}_fastqc.html"
            for index in ["1","2"]
            for c in combo
            if c['Run'] == wildcards.run
        ]
    output: f"{output_dir}/{{run}}/QC/raw_qc_initial/multiqc_report.html"
    log: f"{logs_dir}/multiqc_initial/{{run}}.log"
    threads: rule_threads("multiqc")
    shell:
        """
        mkdir -p $(dirname {log})
        {MULTIQC_BIN} $(dirname {output}) -o $(dirname {output}) --force > {log} 2>&1
        """

rule combine_cutadapt_logs:
    input:
        lambda wildcards: [
            f"{output_dir}/{c['Run']}/intermediate/cutadapt/{c['Sample']}_cutadapt.log"
            for c in combo if c['Run'] == wildcards.run
        ]
    output:
        summary = f"{output_dir}/{{run}}/intermediate/cutadapt/cutadapt_summary.log",
        merged  = f"{output_dir}/{{run}}/intermediate/cutadapt/cutadapt_primer_trimming_stats.txt",
    log:
        f"{logs_dir}/combine_cutadapt_logs/{{run}}.log"
    run:
        import os
        import re
        import shutil
        import subprocess

        os.makedirs(os.path.dirname(log[0]), exist_ok=True)
        qc_dir = f"{output_dir}/{wildcards.run}/QC/raw_qc_post_cutadapt"
        os.makedirs(qc_dir, exist_ok=True)

        def seqkit_stats(path):
            result = subprocess.run(
                ["seqkit", "stats", "-T", path],
                check=True,
                capture_output=True,
                text=True,
            )
            lines = [line for line in result.stdout.strip().splitlines() if line.strip()]
            fields = lines[-1].split("\t")
            return fields[3], fields[4]

        with open(output.merged, "w") as merged_out, open(output.summary, "w") as summary_out, open(log[0], "w") as log_out:
            summary_out.write("sample\treads_retained\tbps_retained\n")

            for path in input:
                with open(path) as fh:
                    content = fh.read()
                merged_out.write(content)
                if not content.endswith("\n"):
                    merged_out.write("\n")

                sample = os.path.basename(path).replace("_cutadapt.log", "")
                if "mode=bypass_for_dada2_trim" in content:
                    trimmed_r1 = f"{output_dir}/{wildcards.run}/intermediate/cutadapt/{sample}_trimmed_R1.fq.gz"
                    reads, bps = seqkit_stats(trimmed_r1)
                else:
                    reads_match = re.search(r"Pairs written \(passing filters\):\s+([0-9,]+)", content)
                    bps_match = re.search(r"Total written \(filtered\):\s+([0-9,]+) bp", content)
                    if not reads_match or not bps_match:
                        raise ValueError(f"Could not parse cutadapt log: {path}")
                    reads = reads_match.group(1).replace(",", "")
                    bps = bps_match.group(1).replace(",", "")

                summary_out.write(f"{sample}\t{reads}\t{bps}\n")
                shutil.copy2(path, os.path.join(qc_dir, os.path.basename(path)))
                log_out.write(f"{sample}\t{reads}\t{bps}\n")



rule fastqc_post_cutadapt:
    input: f"{output_dir}/{{run}}/intermediate/cutadapt/{{sample}}_trimmed_R{{index}}.fq.gz"
    output: f"{output_dir}/{{run}}/QC/raw_qc_post_cutadapt/{{sample}}_trimmed_R{{index,[^\._]}}_fastqc.html"
    log: f"{logs_dir}/fastqc_post_cutadapt/{{run}}/{{sample}}_R{{index}}.log"
    threads: rule_threads("fastqc")
    shell:
        """
        mkdir -p $(dirname {output})
        mkdir -p $(dirname {log})
        fastqc {input} -o $(dirname {output}) -t {threads} > {log} 2>&1
        """


rule multiqc_final:
    input: 
        lambda wildcards: [
            f"{output_dir}/{c['Run']}/QC/raw_qc_post_cutadapt/{c['Sample']}_trimmed_R{index}_fastqc.html"
            for index in ["1","2"]
            for c in combo
            if c['Run'] == wildcards.run
        ]
    output: f"{output_dir}/{{run}}/QC/raw_qc_post_cutadapt/multiqc_report.html"
    log: f"{logs_dir}/multiqc_final/{{run}}.log"
    threads: rule_threads("multiqc")
    shell:
        """
        mkdir -p $(dirname {log})
        {MULTIQC_BIN} $(dirname {output}) -o $(dirname {output}) --force > {log} 2>&1
        """

rule figaro:
    input:
        lambda wildcards: [
             f"{output_dir}/{wildcards.run}/figaro_inp/{sample}_R{idx}.{file_extension}"
             for sample in sample_by_run[wildcards.run]
             for idx in indices]
    output:
        trimParameters = f"{output_dir}/{{run}}/intermediate/figaro/trimParameters.json"
    log:
        f"{logs_dir}/figaro/{{run}}.log"
    threads: rule_threads("figaro")
    params:
        amplen = amplicon_length,
        forward_primer_length = forward_primer_length,
        reverse_primer_length = reverse_primer_length,
        input_dir = f"{output_dir}/{{run}}/figaro_inp",
        figaroname = figaroname,
        figaro_script = SCRIPT_PATHS['figaro']
    run:
        import subprocess
        import os
        import json
        import sys
        import tempfile
        import gzip

        os.makedirs(f"{output_dir}/{wildcards.run}/intermediate/figaro", exist_ok=True)
        os.makedirs(os.path.dirname(str(log)), exist_ok=True)

        def fastq_length_stats(path):
            stats = subprocess.run(
                ["seqkit", "stats", "-Ta", path],
                check=True,
                capture_output=True,
                text=True,
            )
            lines = [line for line in stats.stdout.strip().splitlines() if line.strip()]
            if len(lines) < 2:
                raise RuntimeError(f"Unable to parse seqkit stats for {path}")
            fields = lines[-1].split("\t")
            if len(fields) < 8:
                raise RuntimeError(f"Unexpected seqkit stats format for {path}: {lines[-1]}")
            return int(fields[5]), int(fields[7])

        def trim_fastq_to_length(src, dst, target_len):
            open_in = gzip.open if src.endswith(".gz") else open
            open_out = gzip.open if dst.endswith(".gz") else open

            with open_in(src, "rt") as handle_in, open_out(dst, "wt") as handle_out:
                while True:
                    header = handle_in.readline()
                    if not header:
                        break
                    sequence = handle_in.readline().rstrip("\n")
                    plus = handle_in.readline()
                    quality = handle_in.readline().rstrip("\n")

                    handle_out.write(header)
                    handle_out.write(sequence[:target_len] + "\n")
                    handle_out.write(plus)
                    handle_out.write(quality[:target_len] + "\n")

        length_stats = {}
        target_lengths = {}
        for direction in ("1", "2"):
            direction_inputs = [
                str(path)
                for path in list(input)
                if re.search(rf"_R{direction}\.", os.path.basename(str(path)))
            ]
            direction_stats = []
            for path in direction_inputs:
                stats = fastq_length_stats(path)
                length_stats[path] = stats
                direction_stats.append(stats)

            if not direction_stats:
                raise RuntimeError(f"No Figaro input files found for read direction R{direction}")
            target_lengths[direction] = min(min_len for min_len, _ in direction_stats)

        # Run figaro on a clean temporary view of the expected inputs only.
        with tempfile.TemporaryDirectory(
            prefix=f"{wildcards.run}_figaro_",
            dir=f"{output_dir}/{wildcards.run}/intermediate/figaro"
        ) as figaro_input_dir:
            for input_path in list(input):
                input_name = os.path.basename(str(input_path))
                match = re.match(r"(.+)_R([12])\.(.+)$", input_name)
                if not match:
                    raise ValueError(f"Unexpected Figaro input filename: {input_name}")

                original_sample, direction, extension = match.groups()
                renamed_sample = sample_renamed_dict.get(original_sample, original_sample.replace("_", "-"))
                target_name = f"{renamed_sample}_R{direction}.{extension}"
                target_path = os.path.join(figaro_input_dir, target_name)
                source_path = os.path.abspath(str(input_path))
                min_len, max_len = length_stats[source_path]
                target_len = target_lengths[direction]

                if min_len == max_len == target_len:
                    os.symlink(source_path, target_path)
                else:
                    trim_fastq_to_length(source_path, target_path, target_len)

            figaro_env = os.environ.copy()
            figaro_env["FIGARO_CORES"] = str(threads)

            with open(str(log), "w") as log_handle:
                log_handle.write(
                    "Normalized Figaro read lengths: "
                    + ", ".join(
                        f"R{direction}={target_lengths[direction]}"
                        for direction in ("1", "2")
                    )
                    + "\n"
                )
                subprocess.run([
                    "python", params.figaro_script,
                    "-i", figaro_input_dir,
                    "-o", f"{output_dir}/{wildcards.run}/intermediate/figaro",
                    "-a", str(params.amplen),
                    "-f", str(params.forward_primer_length),
                    "-r", str(params.reverse_primer_length),
                    "-F", params.figaroname
                ], check=True, stdout=log_handle, stderr=subprocess.STDOUT, env=figaro_env)

        if dry_run_tune:
            try:
                with open(output.trimParameters) as f:
                    records = json.load(f)

                    if not isinstance(records, list):
                        records = [records]

                    records = records[:5]

            except json.JSONDecodeError as e:
                print(f"Error reading JSON file: {e}", file=sys.stderr)
                records = []

            headers = ["trimPosition", "maxExpectedError", "readRetentionPercent", "score"]
            print(" | ".join(headers))
            print("-" * 60)

            for rec in records:
                if not isinstance(rec, dict):
                    print(f"Warning: Skipping non-dictionary record: {rec}", file=sys.stderr)
                    continue

                trim_pos = rec.get('trimPosition', [])
                max_err = rec.get('maxExpectedError', [])
                read_ret = rec.get('readRetentionPercent', 0)
                score = rec.get('score', 0)

                if not isinstance(trim_pos, list):
                    trim_pos = [trim_pos]
                if not isinstance(max_err, list):
                    max_err = [max_err]

                print(f"{repr(trim_pos)} | {repr(max_err)} | {read_ret} | {score}")

rule dada2_filter:
    input:
        figaro_params = figaro_input,
        multiQC_out   = f"{output_dir}/{{run}}/QC/raw_qc_post_cutadapt/multiqc_report.html"
    output:
        checkout=f"{output_dir}/{{run}}/intermediate/dada2_filtered/checkout.filter",
        filter_summary=f"{output_dir}/{{run}}/intermediate/dada2_filtered/filter_summary.tsv",
    log:
        f"{logs_dir}/dada2_filter/{{run}}.log"
    threads: rule_threads("dada2_filter")
    params:
        filter_script = SCRIPT_PATHS['dada2_filter'],
        dada2_params  = config.get("dada2_params",""),
        figaro_arg    = figaro_arg,
        trim_left     = dada2_trim_left,
        trim_right    = dada2_trim_right,
        upstream_trim = "" if trim_primers_dada2 else f"{forward_primer_length},{reverse_primer_length}"
    shell:
        r"""
        mkdir -p {output_dir}/{wildcards.run}/intermediate/dada2_filtered
        mkdir -p $(dirname {log})
        Rscript {params.filter_script} \
          {output_dir}/{wildcards.run}/intermediate/cutadapt \
          {output_dir}/{wildcards.run}/intermediate/dada2_filtered \
          {params.figaro_arg} "{params.dada2_params}" "{params.trim_left}" "{params.trim_right}" "{threads}" > {log} 2>&1
        touch {output.checkout}
        """

rule dada2_error_learning:
