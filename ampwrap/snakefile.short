if resource_profile not in RESOURCE_POLICIES:
    raise ValueError(f"Unknown resource profile: {resource_profile}")

def rule_threads(rule_name):
    policy = RESOURCE_POLICIES[resource_profile][rule_name]
    scaled = math.ceil(int(threads) * float(policy["fraction"]))
    return max(int(policy["min"]), min(int(policy["max"]), scaled, int(threads)))

