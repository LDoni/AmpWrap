rule dada2_assign_taxonomy:
    input:
        no_chimera_asvs = f"{output_dir}/{chimerae_dir}/no_chimera_asvs.rds",
        db = f"{db_dir}/dada2/{out_name}"
    output:
        asvs=f"{output_dir}/results/ASVs.fa",
        asvs_counts=f"{output_dir}/results/ASVs_counts.tsv",
        taxonomy=f"{output_dir}/results/ASVs_taxonomy.tsv",
    log:
        f"{logs_dir}/dada2_assign_taxonomy/{assign_taxonomy_method}.log"
    params:
        method=assign_taxonomy_method,
        tax_scriptdada16S=SCRIPT_PATHS['dada2_assign_taxonomy16S'],
        tax_script_dechipher=SCRIPT_PATHS['dada2_assign_taxonomyDHCP'],
        tax_scriptdadaPr2=SCRIPT_PATHS['dada2_assign_taxonomyPR2'],
        tax_scriptdada18S=SCRIPT_PATHS['dada2_assign_taxonomy18S']
    shell:
        """
        mkdir -p "{output_dir}/results"
        mkdir -p $(dirname {log})
        if [[ {params.method} == "decipher_silva138" || {params.method} == "decipher_gtdb226" || {params.method} == "decipher_rdp18" ]]; then
            Rscript {params.tax_script_dechipher} {input.no_chimera_asvs} {input.db} {output_dir}/results > {log} 2>&1
        elif [[ {params.method} == "dada2_silva_genus138" || {params.method} == "dada2_RDP_genus19" || {params.method} == "dada2_GG2_genus09" || {params.method} == "dada2_RefSeq_RDPv16" || {params.method} == "dada2_GTDB_r202" ]]; then
             Rscript {params.tax_scriptdada16S} {input.no_chimera_asvs} {input.db} {output_dir}/results > {log} 2>&1
        elif [[ {params.method} == "dada2_pr2_5.1.1" ]]; then
            Rscript {params.tax_scriptdadaPr2} {input.no_chimera_asvs} {input.db} {output_dir}/results > {log} 2>&1
        elif [[ {params.method} == "dada2_18S_silva132" ]]; then
            Rscript {params.tax_scriptdada18S} {input.no_chimera_asvs} {input.db} {output_dir}/results > {log} 2>&1
        else
            echo "Error: method not valid."
            echo " try: ampwrap short --db-info"
            exit 1
        fi
        """













rule track_reads:
    input: unpack(trackReadsDict)
    output:
        checkout=f"{output_dir}/results/read-count-tracking.tsv"
    log:
        f"{logs_dir}/track_reads/track_reads.log"
    params:
        track_script=SCRIPT_PATHS['track_reads'],
    shell:
        """
        mkdir -p $(dirname {log})
        Rscript {params.track_script} \
        {input.summaries} {input.fwd} {input.rev} {input.merged} {input.chimera} {output.checkout} > {log} 2>&1
        """

rule reporter:
    input:
        summaries = expand(f"{output_dir}" + "/{run}/intermediate/cutadapt/cutadapt_summary.log",
                           run=runs),
        track_report = f"{output_dir}/results/read-count-tracking.tsv",
        ASV = f"{output_dir}/results/ASVs.fa",
        error_models = expand(f"{output_dir}" + "/{run}/intermediate/dada2_error_learning/model_selection.tsv",
                              run=runs)
    output:
        report = f"{output_dir}/results/final_report.txt",
    log:
        f"{logs_dir}/reporter/final_report.log"
    params:
        forward_p = forward_primer,
        reverse_p = reverse_primer,
        start = analysis_start,
        workflow_file = workflow.snakefile,
        version = version,
        taxonomy_method = assign_taxonomy_method,
        reporter=SCRIPT_PATHS['reporter'],
        dada2_params = dada2_params,
        loess_model = config.get("loess_model", "auto"),
        runs = runs,
        use_figaro = USE_FIGARO,
        output_dir = output_dir    
    script:
        SCRIPT_PATHS['reporter']
