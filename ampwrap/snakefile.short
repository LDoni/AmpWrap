        """

rule download_dada2_db:
    output:
        dada2_db=f"{db_dir}/dada2/{out_name}"
    log:
        f"{logs_dir}/download_dada2_db/{assign_taxonomy_method}.log"
    params:
        url=db_config["url"],
        md5=db_config["md5"],
        filename=db_config["filename"]
    shell:
        """
        mkdir -p $(dirname {log})
        DB_DIR="$(dirname {output.dada2_db})"
        DB_PATH={output.dada2_db}
        TMP_PATH="${{DB_PATH}}.tmp"

        (
        mkdir -p "$DB_DIR"

        if [ ! -f "$DB_PATH" ]; then
            echo "Downloading {params.filename}..."
            rm -f "$TMP_PATH"
            wget --quiet -O "$TMP_PATH" "{params.url}"
            test -s "$TMP_PATH"
            mv "$TMP_PATH" "$DB_PATH"
        fi

        echo "Checking MD5 checksum..."
        MD5_CALC=$(md5sum "$DB_PATH" | awk '{{print $1}}')
        if [ "$MD5_CALC" != "{params.md5}" ]; then
            echo "MD5 mismatch for {params.filename}"
            echo "Expected: {params.md5}"
            echo "Got:      $MD5_CALC"
            exit 1
        else
            echo "MD5 verified for {params.filename}"
        fi

        python {SCRIPT_PATHS['update_db_manifest']} \
            --manifest "{db_manifest}" \
            --category "dada2" \
            --name "{assign_taxonomy_method}" \
            --filename "{params.filename}" \
            --md5 "{params.md5}" \
            --source-url "{params.url}" \
            --local-path "$DB_PATH"
        ) > {log} 2>&1
        """


rule download_dada2_species_db:
    output:
        dada2_species_db=f"{db_dir}/dada2/{species_out_name}"
    log:
        f"{logs_dir}/download_dada2_db/{assign_taxonomy_method}.species.log"
    params:
        url=db_config.get("species_url", ""),
        md5=db_config.get("species_md5", ""),
        filename=db_config.get("species_filename", "")
    shell:
        """
        mkdir -p $(dirname {log})
        DB_DIR="$(dirname {output.dada2_species_db})"
        DB_PATH={output.dada2_species_db}
        TMP_PATH="${{DB_PATH}}.tmp"

        (
        if [ -z "{params.filename}" ] || [ -z "{params.url}" ]; then
            echo "Species database metadata is not available for {assign_taxonomy_method}"
            exit 1
        fi

        mkdir -p "$DB_DIR"

        if [ ! -f "$DB_PATH" ]; then
            echo "Downloading {params.filename}..."
            rm -f "$TMP_PATH"
            wget --quiet -O "$TMP_PATH" "{params.url}"
            test -s "$TMP_PATH"
            mv "$TMP_PATH" "$DB_PATH"
        fi

        if [ -n "{params.md5}" ]; then
            echo "Checking MD5 checksum..."
            MD5_CALC=$(md5sum "$DB_PATH" | awk '{{print $1}}')
            if [ "$MD5_CALC" != "{params.md5}" ]; then
                echo "MD5 mismatch for {params.filename}"
                echo "Expected: {params.md5}"
                echo "Got:      $MD5_CALC"
                exit 1
            else
                echo "MD5 verified for {params.filename}"
            fi
        else
            echo "MD5 not provided for {params.filename}; skipping checksum verification."
        fi

        python {SCRIPT_PATHS['update_db_manifest']} \
            --manifest "{db_manifest}" \
            --category "dada2" \
            --name "{assign_taxonomy_method}.species" \
            --filename "{params.filename}" \
            --md5 "{params.md5}" \
            --source-url "{params.url}" \
            --local-path "$DB_PATH"
        ) > {log} 2>&1
        """


