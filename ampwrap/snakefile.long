import os
import hashlib


def load_ampwrap_version():
    version_path = os.path.join(os.path.dirname(os.path.abspath(workflow.snakefile)), "VERSION")
    try:
        with open(version_path) as handle:
            return handle.read().strip()
    except OSError:
        return "unknown"


version = load_ampwrap_version()

# Configure input output directories
latency_wait = 20
input_dir = os.path.realpath(os.path.abspath(os.path.expanduser(config["input_dir"])))
output_dir = os.path.realpath(os.path.abspath(os.path.expanduser(config["output_dir"])))
logs_dir = os.path.realpath(
    os.path.abspath(
        os.path.expanduser(config.get("logs", os.path.join(output_dir, "logs")))
    )
)
config["input_dir"] = input_dir
config["output_dir"] = output_dir
config["logs"] = logs_dir
sample_names = config["sample_names"]
file_extension = config["file_extension"]
trimming_method = config.get("trimming_method")
tax_db = config["tax_db"]
db_root = os.path.realpath(
    os.path.abspath(os.path.expanduser(config.get("db_dir", "db_s/emu")))
)
config["db_dir"] = db_root
db_dir = os.path.join(db_root, tax_db)
db_manifest = os.path.join(os.path.dirname(db_root.rstrip("/")), "manifest.tsv")
cpus = int(config["threads"])
#to_cutadapt = all(p in config and config[p] not in [None, ""] for p in ["forward_primer", "reverse_primer"])
chimera = config.get("chimera", None)
suffix = "scrubbed" if chimera else "nanofilt"
keepcounts = "" if not config.get("keep_counts",False) else "--keep-counts"



to_cutadapt = all(
    p in config and config[p] not in [None, "", "null", "None"]
    for p in ["forward_primer", "reverse_primer"]
)


forward_primer = config.get("forward_primer")
reverse_primer = config.get("reverse_primer")
CONDA_BIN = os.path.join(os.environ.get('CONDA_PREFIX', ''), 'bin')
SEQKIT_BIN = os.path.join(CONDA_BIN, 'seqkit') if CONDA_BIN else 'seqkit'
FASTQC_BIN = os.path.join(CONDA_BIN, 'fastqc') if CONDA_BIN else 'fastqc'
MULTIQC_BIN = os.path.join(CONDA_BIN, 'multiqc') if CONDA_BIN else 'multiqc'
EMU_BIN = os.path.join(CONDA_BIN, 'emu') if CONDA_BIN else 'emu'
LOCAL_SCRIPTS_DIR = os.path.join(os.path.dirname(os.path.abspath(workflow.snakefile)), 'scripts')
if os.path.exists(LOCAL_SCRIPTS_DIR):
    SCRIPTS_DIR = LOCAL_SCRIPTS_DIR
elif os.path.exists(os.path.join(CONDA_BIN, 'scripts')):
    SCRIPTS_DIR = os.path.join(CONDA_BIN, 'scripts')
else:
    SCRIPTS_DIR = 'scripts'

UPDATE_DB_MANIFEST = os.path.join(SCRIPTS_DIR, "update_db_manifest.py")

def getCutAdaptInput(wildcards):
        if trimming_method == None: return({"fq":f"{input_dir}/{wildcards.sample}.{file_extension}"})
        return({"fq":f"{output_dir}/intermediate/porechop/{wildcards.sample}-porechop.fastq.gz"})

def getNanoFiltInput(wildcards):
        raw_sample = wildcards.sample
        if to_cutadapt == True: return({"fq":f"{output_dir}/intermediate/cutadapt/{raw_sample}_cutadapt.fq.gz"})
        else:
            if trimming_method != None: return({"fq":f"{output_dir}/intermediate/porechop/{raw_sample}-porechop.fastq.gz"})
            else: return({"fq":f"{input_dir}/{raw_sample}.{file_extension}"})

def getEmuInput(wildcards):
        fastq = (
            f"{output_dir}/intermediate/nanofilt/{wildcards.sample}-scrubbed.fastq"
            if chimera == True
            else f"{output_dir}/intermediate/nanofilt/{wildcards.sample}-nanofilt.fastq"
        )
        return {
            "fastq": fastq,
            "taxonomy": f"{db_dir}/taxonomy.tsv",
            "taxids": f"{db_dir}/species_taxid.fasta",
        }

# nanofilt parameters
nl_min_len = config.get("nl_min_len",1200)
nl_max_len = config.get("nl_max_len",1800)
nl_min_qual = config.get("nl_min_qual",10)

# emu parameters

emu_min_ab = config.get("emu_min_ab", 0.0001)

def reverse_complement(seq):
    if seq is None:
        return None
    from Bio.Seq import Seq
    seq = Seq(seq)
    return seq.reverse_complement()

RC_FWD = reverse_complement(forward_primer) if forward_primer else None
RC_RVS = reverse_complement(reverse_primer) if reverse_primer else None




rule all:
    input:
        # QC initial
        expand(f"{config['output_dir']}/QC/raw_qc_initial/{{sample}}_fastqc.html", sample = sample_names),
        f"{config['output_dir']}/QC/raw_qc_initial/readcount/raw_reads_counts.txt",
        f"{config['output_dir']}/QC/raw_qc_initial/multiqc_report.html",
        #Porechop
        expand(f"{config['output_dir']}/intermediate/porechop/{{sample}}-porechop.fastq.gz", sample=sample_names) if trimming_method != None else [],
        #Cutadapt
        expand(f"{config['output_dir']}/intermediate/cutadapt/{{sample}}_cutadapt.fq.gz", sample=sample_names) if to_cutadapt else [],
        f"{config['output_dir']}/intermediate/cutadapt/cutadapt_primer_trimming_stats.txt" if to_cutadapt else [],
        #Qc post
        expand(f"{config['output_dir']}/QC/raw_qc_post/{{sample}}-nanofilt_fastqc.html", sample=sample_names),
        f"{config['output_dir']}/QC/raw_qc_post/multiqc_report.html",
        f"{config['output_dir']}/QC/raw_qc_post/readcount/filtered_reads_counts.txt",
        expand(f"{config['output_dir']}/intermediate/nanofilt/{{sample}}-{suffix}.fastq", sample=sample_names) if chimera else [],
        #emuDB
        f"{db_dir}",
        expand("{db_dir}/{tax_file}",db_dir=db_dir,tax_file=["taxonomy.tsv","species_taxid.fasta"]),
        #emu
        expand(f"{output_dir}/results/emu/{{sample}}-{suffix}_rel-abundance.tsv", sample=sample_names),
        #handoff
        f"{output_dir}/results/emu/emu_phyloseq.rds",
        f"{output_dir}/results/emu/emu_abundance.biom",
        #final report
        f"{config['output_dir']}/results/final_report.txt"


rule seqkit_stats_pre_qc:
    input:
        expand("{input_dir}/{sample}.{file_extension}",
               input_dir=input_dir,
               sample=sample_names,
               file_extension=file_extension)
    output:
        f"{output_dir}/QC/raw_qc_initial/readcount/raw_reads_counts.txt"
    log:
        f"{logs_dir}/seqkit_stats_pre_qc/seqkit_stats_pre_qc.log"
    shell:
        """
        mkdir -p "$(dirname {output:q})"
        mkdir -p "$(dirname {log:q})"
        {SEQKIT_BIN} stats -T -j {cpus} {input:q} > {output:q} 2> {log:q}
        """

rule fastqc_initial:
    input:
        f"{input_dir}/{{sample}}.{file_extension}"
    output:
        f"{output_dir}/QC/raw_qc_initial/{{sample}}_fastqc.html"
    log:
        f"{logs_dir}/fastqc_initial/{{sample}}.log"
    shell:
        """
        mkdir -p "$(dirname {output:q})"
        mkdir -p "$(dirname {log:q})"
        {FASTQC_BIN} {input:q} -o "$(dirname {output:q})" > {log:q} 2>&1
        """

rule multiqc_initial:
    input: expand("{output_dir}/QC/raw_qc_initial/{sample}_fastqc.html",output_dir=output_dir,sample=sample_names)
    output: f"{output_dir}/QC/raw_qc_initial/multiqc_report.html"
    log: f"{logs_dir}/multiqc_initial/multiqc_initial.log"
    shell:
        """
        mkdir -p "$(dirname {log:q})"
        {MULTIQC_BIN} "$(dirname {output:q})" -o "$(dirname {output:q})" --force > {log:q} 2>&1
        """

rule porechop:
    input:
        f"{input_dir}/{{sample}}.{file_extension}"
    output:
        fq=f"{output_dir}/intermediate/porechop/{{sample}}-porechop.fastq.gz"
    log:
        f"{logs_dir}/porechop/{{sample}}.log"
    run:
        import subprocess

        if trimming_method == "porechop_abi":
            cmd = ["porechop_abi", "-abi", "-i", str(input[0]), "-o", str(output.fq)]
        elif trimming_method == "porechop":
            cmd = ["porechop", "-i", str(input[0]), "-o", str(output.fq)]
        else:
            raise ValueError(f"Unsupported trimming_method: {trimming_method}")

        os.makedirs(os.path.dirname(str(output.fq)), exist_ok=True)
        os.makedirs(os.path.dirname(str(log)), exist_ok=True)
        with open(str(log), "w") as log_handle:
            subprocess.run(cmd, check=True, stdout=log_handle, stderr=subprocess.STDOUT)


rule cutadapt_primers:
    input: unpack(getCutAdaptInput)
    output:
        r1_trimmed = f"{output_dir}/intermediate/cutadapt/{{sample}}_cutadapt.fq.gz",
    log:
        f"{logs_dir}/cutadapt/{{sample}}.log"
    params:
        forward_primer = forward_primer,
        reverse_primer = reverse_primer,
        RC_RVS = RC_RVS,

    shell:
      """
      mkdir -p "$(dirname {output.r1_trimmed:q})"
      mkdir -p "$(dirname {log:q})"
      cutadapt -e 0.2 -O 15 --revcomp -o {output.r1_trimmed:q} -a {params.forward_primer:q}...{params.RC_RVS:q} {input.fq:q} > {log:q} 2>&1
      """


rule combine_cutadapt_logs:
    input:
        expand("{logs_dir}/cutadapt/{sample}.log", logs_dir=logs_dir, sample=sample_names)
    output:
        full=f"{output_dir}/intermediate/cutadapt/cutadapt_primer_trimming_stats.txt",
        summary=f"{output_dir}/intermediate/cutadapt/cutadapt_summary.tsv"
    log: f"{logs_dir}/combine_cutadapt_logs/combined_cutadapt.log"
    run:
        import re

        os.makedirs(os.path.dirname(str(output.full)), exist_ok=True)
        os.makedirs(os.path.dirname(str(log)), exist_ok=True)

        rows = []
        with open(output.full, "w") as combined_handle:
            for sample, log_path in zip(sample_names, list(input)):
                with open(log_path) as sample_handle:
                    content = sample_handle.read()
                combined_handle.write(f"===== {sample} =====\n")
                combined_handle.write(content)
                if content and not content.endswith("\n"):
                    combined_handle.write("\n")

                reads_match = re.search(
                    r"Reads written \(passing filters\):.*?\(([0-9.]+)%\)",
                    content,
                )
                bases_match = re.search(
                    r"Total written \(filtered\):.*?\(([0-9.]+)%\)",
                    content,
                )
                if not reads_match or not bases_match:
                    raise RuntimeError(
                        f"Unable to parse Cutadapt retention statistics for sample '{sample}'. "
                        f"See {log_path}"
                    )
                rows.append((sample, reads_match.group(1), bases_match.group(1)))

        with open(output.summary, "w") as summary_handle:
            summary_handle.write("sample\treads retained\tbps retained\n")
            for sample, reads_retained, bases_retained in rows:
                summary_handle.write(
                    f"{sample}\t{reads_retained}%\t{bases_retained}%\n"
                )

        with open(str(log), "w") as log_handle:
            print(f"Combined {len(rows)} Cutadapt logs", file=log_handle)
            print(f"Full log: {output.full}", file=log_handle)
            print(f"Summary: {output.summary}", file=log_handle)

rule nanofilt:
    input:
        unpack(getNanoFiltInput)
    output:
        fq=f"{output_dir}/intermediate/nanofilt/{{sample}}-nanofilt.fastq"
    log:
        f"{logs_dir}/nanofilt/{{sample}}.log"
    shell:
        f"""
        mkdir -p "$(dirname {{output.fq:q}})"
        mkdir -p "$(dirname {{log:q}})"
        if [[ {{input.fq:q}} == *.gz ]]; then
            zcat {{input.fq:q}} | NanoFilt -l {nl_min_len} --maxlength {nl_max_len} -q {nl_min_qual} > {{output.fq:q}} 2> {{log:q}}
        else
            cat {{input.fq:q}} | NanoFilt -l {nl_min_len} --maxlength {nl_max_len} -q {nl_min_qual} > {{output.fq:q}} 2> {{log:q}}
        fi
        """

rule fastqc_post:
    input:
        trimmed_files = f"{output_dir}/intermediate/nanofilt/{{sample}}-nanofilt.fastq"
    output:
        fastqc = f"{output_dir}/QC/raw_qc_post/{{sample}}-nanofilt_fastqc.html"
    log:
        f"{logs_dir}/fastqc_post/{{sample}}.log"
    shell:
        """
        mkdir -p "$(dirname {output.fastqc:q})"
        mkdir -p "$(dirname {log:q})"
        {FASTQC_BIN} {input.trimmed_files:q} -o "$(dirname {output.fastqc:q})" > {log:q} 2>&1
        """

rule multiqc_post:
    input: expand("{output_dir}/QC/raw_qc_post/{sample}-nanofilt_fastqc.html",output_dir=output_dir,sample=sample_names)
    output: f"{output_dir}/QC/raw_qc_post/multiqc_report.html"
    log: f"{logs_dir}/multiqc_post/multiqc_post.log"
    shell:
        """
        mkdir -p "$(dirname {log:q})"
        {MULTIQC_BIN} "$(dirname {output:q})" -o "$(dirname {output:q})" --force > {log:q} 2>&1
        """

rule chimera_scrub:
    input:
        fq=f"{output_dir}/intermediate/nanofilt/{{sample}}-nanofilt.fastq"
    output:
        fq=f"{output_dir}/intermediate/nanofilt/{{sample}}-scrubbed.fastq",
    threads:
        cpus
    params:
        paf=f"{output_dir}/intermediate/nanofilt/{{sample}}.paf",
        yacrd=f"{output_dir}/intermediate/nanofilt/{{sample}}.yacrd"
    log:
        f"{logs_dir}/chimera_scrub/{{sample}}.log"
    shell:
        """
        mkdir -p "$(dirname {log:q})"
        minimap2 -x ava-ont -g 500 -t {threads} {input.fq:q} {input.fq:q} > {params.paf:q} 2> {log:q}
        yacrd -i {params.paf:q} -o {params.yacrd:q} -c 4 -n 0.4 scrubb -i {input.fq:q} -o {output.fq:q} >> {log:q} 2>&1
        rm {params.paf:q}
        """

rule seqkit_stats_post_qc:
    input:
        expand("{output_dir}/intermediate/nanofilt/{sample}-{suffix}.fastq",
               output_dir=output_dir,
               sample=sample_names,
               suffix=suffix)
    output:
        f"{output_dir}/QC/raw_qc_post/readcount/filtered_reads_counts.txt"
    log:
        f"{logs_dir}/seqkit_stats_post_qc/seqkit_stats_post_qc.log"
    shell:
        """
        mkdir -p "$(dirname {output:q})"
        mkdir -p "$(dirname {log:q})"
        {SEQKIT_BIN} stats -T -j {cpus} {input:q} > {output:q} 2> {log:q}
        """


