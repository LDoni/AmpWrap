rule emu_database:
    output:
        the_dir=directory(f"{db_dir}"),
        taxonomy=f"{db_dir}/taxonomy.tsv",
        taxids=f"{db_dir}/species_taxid.fasta"
    params:
        md5_dict={
            "emu": "707f235f515c0dc2e8d74278294241e7",
            "rdp": "5aebf4f791d32950bfa07e5e0e7ea22a",
            "silva": "4195810ceec63ed13b9ee3f9c678c52b",
            "silva-138.2": "0ef414e54624f5b921d7a8eaee3e7cad",
            "unite-fungi": "cd136cac25310f62a32a57fc11a54d71",
            "unite-all": "dc956ccf991575aedb00f11456451d10",
            "pr2": "51e1c9eb383e8770d1ccdf805b35444f"
        }
    log:
        f"{logs_dir}/emu_database/{tax_db}.log"
    run:
        import os
        import subprocess
        archive_dir = os.path.join(db_root, "_archives")
        os.makedirs(output.the_dir, exist_ok=True)
        os.makedirs(archive_dir, exist_ok=True)
        os.makedirs(os.path.dirname(str(log)), exist_ok=True)

        def file_md5(path):
            digest = hashlib.md5()
            with open(path, "rb") as handle:
                for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                    digest.update(chunk)
            return digest.hexdigest()

        with open(str(log), "w") as log_handle:
            if (
                tax_db != "emu-2026"
                and os.path.exists(output.taxonomy)
                and os.path.exists(output.taxids)
            ):
                print(f"Database already present in {output.the_dir}", file=log_handle)
                return

            def download_url(url, destination, expected_md5):
                if os.path.exists(destination):
                    if file_md5(destination) == expected_md5:
                        return
                    print(f"Removing invalid cached file: {destination}", file=log_handle)
                    os.remove(destination)

                temporary = f"{destination}.tmp"
                if os.path.exists(temporary):
                    os.remove(temporary)
                commands = [
                    ["curl", "-L", "--fail", "-o", temporary, url],
                    ["wget", "-O", temporary, url],
                ]
                last_error = None
                for command in commands:
                    try:
                        subprocess.run(
                            command,
                            check=True,
                            stdout=log_handle,
                            stderr=subprocess.STDOUT,
                        )
                        break
                    except subprocess.CalledProcessError as exc:
                        last_error = exc
                else:
                    raise last_error

                if file_md5(temporary) != expected_md5:
                    os.remove(temporary)
                    raise ValueError(
                        f"ERROR: MD5 checksum failed for downloaded file {destination}"
                    )
                os.replace(temporary, destination)

            if tax_db == "emu-2026":
                direct_files = [
                    (
                        str(output.taxonomy),
                        "https://osf.io/download/thxve/",
                        "6f38e42f7012571a13a5f9ecaca10966",
                    ),
                    (
                        str(output.taxids),
                        "https://osf.io/download/ahksz/",
                        "e06ceeff3126304a4e43e71167bd9282",
                    ),
                ]
                for destination, source_url, expected_md5 in direct_files:
                    download_url(source_url, destination, expected_md5)
                    subprocess.run(
                        [
                            "python",
                            UPDATE_DB_MANIFEST,
                            "--manifest", db_manifest,
                            "--category", "emu",
                            "--name", tax_db,
                            "--filename", os.path.basename(destination),
                            "--md5", expected_md5,
                            "--source-url", source_url,
                            "--local-path", output.the_dir,
                        ],
                        check=True,
                        stdout=log_handle,
                        stderr=subprocess.STDOUT,
                    )
                return

            elif tax_db == "pr2":
                db_zip = os.path.join(archive_dir, "pr2_version_5.1.1_emu.zip")
                db_url = "https://github.com/pr2database/pr2database/releases/download/v5.1.1/pr2_version_5.1.1_emu.zip"
                extracted_fasta = os.path.join(output.the_dir, "pr2_version_5.1.1_emu.fasta")
                extracted_taxonomy = os.path.join(output.the_dir, "pr2_version_5.1.1_emu_taxo.tsv")
                extracted_map = os.path.join(output.the_dir, "pr2_version_5.1.1_emu_map.tsv")
                direct_taxonomy = os.path.join(output.the_dir, "pr2_direct_taxonomy.tsv")
                build_dir = os.path.join(output.the_dir, "pr2_build")
                expected_md5 = params.md5_dict["pr2"]

                download_url(db_url, db_zip, expected_md5)
                subprocess.run(["unzip", "-o", db_zip, "-d", output.the_dir], check=True, stdout=log_handle, stderr=subprocess.STDOUT)
                if not os.path.exists(extracted_fasta) or not os.path.exists(extracted_taxonomy) or not os.path.exists(extracted_map):
                    raise ValueError(
                        "ERROR: PR2 archive did not contain the expected EMU files "
                        f"({os.path.basename(extracted_fasta)}, {os.path.basename(extracted_taxonomy)}, {os.path.basename(extracted_map)})"
                    )
                with open(extracted_taxonomy, encoding="utf8") as in_handle, open(direct_taxonomy, "w", encoding="utf8") as out_handle:
                    header = "tax_id\tspecies\tgenus\tfamily\torder\tclass\tphylum\tclade\tsuperkingdom\n"
                    out_handle.write(header)
                    next(in_handle)
                    for line in in_handle:
                        fields = line.rstrip("\n").split("\t")
                        if len(fields) < 10:
                            continue
                        tax_id, domain, supergroup, division, subdivision, class_name, order_name, family, genus, species = fields[:10]
                        clade = supergroup if supergroup else subdivision
                        out_handle.write(
                            "\t".join([
                                tax_id,
                                species,
                                genus,
                                family,
                                order_name,
                                class_name,
                                division,
                                clade,
                                domain,
                            ]) + "\n"
                        )

                subprocess.run(
                    [
                        EMU_BIN,
                        "build-database",
                        "--sequences", extracted_fasta,
                        "--seq2tax", extracted_map,
                        "--taxonomy-list", direct_taxonomy,
                        build_dir,
                    ],
                    check=True,
                    cwd=output.the_dir,
                    stdout=log_handle,
                    stderr=subprocess.STDOUT,
                )
                built_taxonomy = os.path.join(build_dir, "taxonomy.tsv")
                built_fasta = os.path.join(build_dir, "species_taxid.fasta")
                if not os.path.exists(built_taxonomy) or not os.path.exists(built_fasta):
                    raise ValueError("ERROR: EMU PR2 database build did not produce taxonomy.tsv and species_taxid.fasta")
                os.replace(built_taxonomy, output.taxonomy)
                os.replace(built_fasta, output.taxids)
                subprocess.run(
                    [
                        "python",
                        UPDATE_DB_MANIFEST,
                        "--manifest", db_manifest,
                        "--category", "emu",
                        "--name", tax_db,
                        "--filename", os.path.basename(db_zip),
                        "--md5", params.md5_dict["pr2"],
                        "--source-url", db_url,
                        "--local-path", output.the_dir,
                    ],
                    check=True,
                    stdout=log_handle,
                    stderr=subprocess.STDOUT,
                )

            else:
                is_unite = tax_db in {"unite-fungi", "unite-all"}
                archive_suffix = ".tar.gz" if is_unite else ".tar"
                archive_name = f"{tax_db}{archive_suffix}"
                db_tar = os.path.join(archive_dir, archive_name)
                remote_path = f"osfstorage/emu-prebuilt/{archive_name}"
                db_url = f"osf://56uf7/emu-prebuilt/{archive_name}"
                expected_md5 = params.md5_dict[tax_db]
                if os.path.exists(db_tar) and file_md5(db_tar) != expected_md5:
                    print(f"Removing invalid cached archive: {db_tar}", file=log_handle)
                    os.remove(db_tar)
                if not os.path.exists(db_tar):
                    tmp_tar = f"{db_tar}.tmp"
                    if os.path.exists(tmp_tar):
                        os.remove(tmp_tar)
                    subprocess.run(
                        ["osf", "-p", "56uf7", "fetch", remote_path, tmp_tar],
                        check=True,
                        stdout=log_handle,
                        stderr=subprocess.STDOUT,
                    )
                    if file_md5(tmp_tar) != expected_md5:
                        os.remove(tmp_tar)
                        raise ValueError(f"ERROR: MD5 checksum failed for downloaded archive {db_tar}")
                    os.replace(tmp_tar, db_tar)

                extract_command = ["tar", "-xvf", db_tar, "-C", output.the_dir]
                if is_unite:
                    extract_command = [
                        "tar", "-xzvf", db_tar, "--strip-components=1",
                        "--exclude=*/._*",
                        "-C", output.the_dir,
                    ]
                subprocess.run(
                    extract_command,
                    check=True,
                    stdout=log_handle,
                    stderr=subprocess.STDOUT,
                )
                if not os.path.exists(output.taxonomy) or not os.path.exists(output.taxids):
                    raise ValueError(
                        f"ERROR: {tax_db} archive did not produce taxonomy.tsv and species_taxid.fasta"
                    )
                subprocess.run(
                    [
                        "python",
                        UPDATE_DB_MANIFEST,
                        "--manifest", db_manifest,
                        "--category", "emu",
                        "--name", tax_db,
                        "--filename", os.path.basename(db_tar),
                        "--md5", params.md5_dict[tax_db],
                        "--source-url", db_url,
                        "--local-path", output.the_dir,
                    ],
                    check=True,
                    stdout=log_handle,
                    stderr=subprocess.STDOUT,
                )


rule emu_abundance:
    input:
        unpack(getEmuInput)
    output:
        f"{output_dir}/results/emu/{{sample}}-{suffix}_rel-abundance.tsv",
    log:
        f"{logs_dir}/emu_abundance/{{sample}}.log"
    params:
        type='map-ont',
        min_ab=emu_min_ab,
        db=db_dir,
        keepcounts=keepcounts
    threads:
        cpus
    shell:
        """
        mkdir -p "$(dirname {output:q})"
        mkdir -p "$(dirname {log:q})"
        echo {EMU_BIN:q} abundance {input.fastq:q} --output-dir "$(dirname {output:q})" --db {params.db:q} --threads {threads} --min-abundance {params.min_ab} {params.keepcounts} > {log:q}
        {EMU_BIN:q} abundance {input.fastq:q} --output-dir "$(dirname {output:q})" --db {params.db:q} --threads {threads} --min-abundance {params.min_ab} {params.keepcounts} >> {log:q} 2>&1
        """

rule emu_phyloseq:
    input:
        expand("{output_dir}/results/emu/{sample}-{suffix}_rel-abundance.tsv",
               output_dir=output_dir, sample=sample_names, suffix=suffix)
    output:
        f"{output_dir}/results/emu/emu_phyloseq.rds",
        f"{output_dir}/results/emu/emu_abundance.biom"
    log:
        f"{logs_dir}/emu_phyloseq/emu_phyloseq.log"
    params:
        emu_dir=lambda wildcards: f"{output_dir}/results/emu"
    script:
        "scripts/emu_handoff.R"

rule reporter:
    input:
        seqkit_pre = f"{config['output_dir']}/QC/raw_qc_initial/readcount/raw_reads_counts.txt",
        seqkit_post = f"{config['output_dir']}/QC/raw_qc_post/readcount/filtered_reads_counts.txt",
        emu_results = expand(
            "{output_dir}/results/emu/{sample}-{suffix}_rel-abundance.tsv",
            output_dir=config['output_dir'],
            sample=config['sample_names'],
            suffix=suffix
        ),
        **({ "cutadapt": f"{config['output_dir']}/intermediate/cutadapt/cutadapt_summary.tsv" } if to_cutadapt else {})
    output:
        report = f"{config['output_dir']}/results/final_report.txt"
    log:
        f"{logs_dir}/reporter/final_report.log"
    params:
        config.get("trimming_method"),
        nl_min_qual = config["nl_min_qual"],
        nl_min_len = config["nl_min_len"],
        nl_max_len = config["nl_max_len"],
        emu_min_ab = config["emu_min_ab"],
        forward_p = config.get("forward_primer"),
        reverse_p = config.get("reverse_primer"),
        RC_FWD = RC_FWD,
        RC_RVS = RC_RVS,
        tax_db = config["tax_db"],
        version = version,
        to_cutadapt = to_cutadapt,
        trimming_method = trimming_method
    script:
        "scripts/reporter_long.py"
