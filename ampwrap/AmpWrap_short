def FVieiraStandard(file_):
    fileName = os.path.basename(file_)
    basename = re.sub(r"\.(fastq|fq)(\.gz)?$", "", fileName, flags=re.IGNORECASE)
    try:
        sample, direction = basename.rsplit("_", 1)
        direction = direction.replace("R", "").replace("r", "")
        direction = int(direction)
        if direction not in (1, 2) or not sample:
            raise ValueError
    except ValueError:
        raise ValueError(
            f"{fileName} does not appear to be a valid file for this standard. Please check file naming convention."
        )
    return file_, fileName, sample, direction

def IlluminaStandard(file_):
    fileName = os.path.basename(file_)
    try:
        baseName = fileName.split(".")[0]
        baseSplit = baseName.split("_")
        group = "_".join(baseSplit[:-4])
        sample = baseSplit[-5]
        direction = int(baseSplit[-2].replace("R", ""))
    except (ValueError, IndexError):
        raise ValueError(
            f"{fileName} does not appear to be a valid Illumina file name. Please check file naming convention."
        )
    return file_, fileName, sample, direction

def parse_cores(value):
    if isinstance(value, int):
        if value < 1:
            raise argparse.ArgumentTypeError("--cores must be >= 1")
        return value

    lowered = str(value).strip().lower()
    if lowered == "all":
        return "all"

    try:
        parsed = int(lowered)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("--cores must be a positive integer or 'all'") from exc

    if parsed < 1:
        raise argparse.ArgumentTypeError("--cores must be >= 1")
    return parsed


def parse_positive_int(value, option_name):
    try:
        parsed = int(str(value).strip())
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"{option_name} must be a positive integer") from exc
    if parsed < 1:
        raise argparse.ArgumentTypeError(f"{option_name} must be >= 1")
    return parsed


def parse_nonnegative_int(value, option_name):
    try:
        parsed = int(str(value).strip())
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"{option_name} must be a non-negative integer") from exc
    if parsed < 0:
        raise argparse.ArgumentTypeError(f"{option_name} must be >= 0")
    return parsed


def parse_max_reads(value):
    return parse_positive_int(value, "--max-reads-per-sample")


def parse_asv_length_tolerance(value):
    return parse_positive_int(value, "--asv-length-tolerance")


def parse_asv_length_spec(value):
    lowered = str(value).strip().lower()
    if lowered == "auto":
        return ("auto", None, None)

    match = re.fullmatch(r"(\d+)\s*:\s*(\d+)", str(value).strip())
    if not match:
        raise argparse.ArgumentTypeError(
            "--asv-length must be 'auto' or a range in the form MIN:MAX, e.g. 360:385"
        )

    minimum = parse_nonnegative_int(match.group(1), "--asv-length")
    maximum = parse_nonnegative_int(match.group(2), "--asv-length")
    if minimum > maximum:
        raise argparse.ArgumentTypeError("--asv-length minimum cannot be greater than maximum")
    return ("range", minimum, maximum)


def parse_trim_pair(value, option_name):
    parts = [p.strip() for p in str(value).split(",")]
    if len(parts) != 2:
        raise argparse.ArgumentTypeError(
            f"{option_name} must contain exactly two comma-separated integers, e.g. 19,20"
        )
    return tuple(parse_nonnegative_int(part, option_name) for part in parts)


def parse_resource_profile(value):
    lowered = str(value).strip().lower()
    if lowered not in {"safe", "balanced", "aggressive"}:
        raise argparse.ArgumentTypeError(
            "--resource-profile must be one of: safe, balanced, aggressive"
        )
    return lowered


