def sanitize_run_name(path):
    base_name = os.path.basename(os.path.normpath(path))
    sanitized = re.sub(r"[^A-Za-z0-9._-]+", "_", base_name).strip("._-")
    return sanitized or "run"


def ensure_unique_run_name(candidate, seen_names):
    if candidate not in seen_names:
        seen_names.add(candidate)
        return candidate

    counter = 2
    while f"{candidate}_{counter}" in seen_names:
        counter += 1
    unique_name = f"{candidate}_{counter}"
    seen_names.add(unique_name)
    return unique_name


def validate_dada2_params(raw_params):
    if not raw_params:
        return None

    cleaned = raw_params.strip()
    if not cleaned:
        return None

    parsed = {}
    for chunk in [p.strip() for p in cleaned.split(";") if p.strip()]:
        if "=" not in chunk:
            raise ValueError(
                f"Invalid --dada2_params entry '{chunk}'. Use key=value pairs separated by ';', "
                "for example 'truncLen=c(240,200);maxEE=c(2,2)'."
            )
        key, value = chunk.split("=", 1)
        parsed[key.strip()] = value.strip()

    missing = [key for key in ("truncLen", "maxEE") if key not in parsed]
    if missing:
        raise ValueError(
            "When --dada2_params is used, both truncLen and maxEE must be provided. "
            f"Missing: {', '.join(missing)}."
        )
    return cleaned


def validate_paired_samples(parsed_files, input_dir):
    sample_to_directions = {}
    sample_to_files = {}
    for file_path, file_name, sample, direction in parsed_files:
        sample_to_directions.setdefault(sample, set()).add(direction)
        sample_to_files.setdefault(sample, {})[direction] = file_name

    invalid = {
        sample: sorted(directions)
        for sample, directions in sample_to_directions.items()
        if directions != {1, 2}
    }
    if invalid:
        normalized_groups = {}
        for sample, directions in invalid.items():
            normalized = re.sub(r"[-_]+", "", sample).lower()
            normalized_groups.setdefault(normalized, []).append((sample, directions))

        probable_pair_typos = []
        for normalized, members in sorted(normalized_groups.items()):
            seen_directions = set()
            for _, directions in members:
                seen_directions.update(directions)
            if seen_directions == {1, 2} and len(members) > 1:
                details = []
                for sample, directions in members:
                    direction_labels = ",".join(f"R{direction}" for direction in directions)
                    file_labels = ", ".join(
                        sample_to_files.get(sample, {}).get(direction, f"{sample} (missing R{direction})")
                        for direction in sorted(directions)
                    )
                    details.append(f"{sample} -> {direction_labels} [{file_labels}]")
                probable_pair_typos.append("; ".join(details))

        if probable_pair_typos:
            raise ValueError(
                f"Input directory '{input_dir}' contains read pairs with inconsistent sample naming. "
                "AmpWrap detected likely R1/R2 pair typos caused by separators or small basename differences, for example '_' vs '-'. "
                f"Details: {' | '.join(probable_pair_typos)}"
            )

        details = "; ".join(
            f"{sample} has directions {dirs}" for sample, dirs in sorted(invalid.items())
        )
        raise ValueError(
            f"Input directory '{input_dir}' does not contain valid paired-end files for all samples: {details}. "
            "Each sample must have exactly one R1 file and one R2 file."
        )


def write_config_yaml(input_dir, output_dir, forward_primer, reverse_primer, amplen, db_choice,
metainfo, extension, figaro_name, trim_primers_dada2, disable_discard_untrimmed, dry_run_tune,
dada2_params=None, threads=None, loess_model=None, max_reads_per_sample=None, db_dir=None,
asv_length_mode="off", asv_length_tolerance=None, asv_length_min=None, asv_length_max=None, bigdata_mode=False,
dada2_trim_left=None, dada2_trim_right=None, resource_profile="balanced", species=False,
remove_organelle_phyloseq=False):
    config = {
        "input_dir": input_dir,
        "output_dir": output_dir,
        "forward_primer": forward_primer,
        "reverse_primer": reverse_primer,
        "amplicon_length": amplen,
        "assign_taxonomy_method": db_choice,
        "sample_tab": os.path.join(output_dir, "sample.tab"),
        "db_dir": db_dir if db_dir else default_db_dir(),
        "read": [1, 2],
        "sample": [f[1].split(".")[0] for f in metainfo],
        "script": "script",
        "logs": os.path.join(output_dir, "logs"),
        "file_extension": extension,
        "figaro_name": figaro_name,
        "dada2_params": dada2_params if dada2_params else "",
        "loess_model": loess_model if loess_model else "auto",
        "analysis_start": datetime.datetime.now().isoformat(timespec="seconds"),
        "dada2_source": "user" if dada2_params else "figaro",
        "max_reads_per_sample": max_reads_per_sample if max_reads_per_sample else 0,
        "asv_length_mode": asv_length_mode,
        "trim_primers_dada2": bool(trim_primers_dada2),
        "disable_discard_untrimmed": disable_discard_untrimmed,
        "dry_run_tune": dry_run_tune,
        "threads": threads if threads not in (None, "all") else os.cpu_count(),
        "bigdata_mode": bool(bigdata_mode),
        "resource_profile": resource_profile,
        "species_assignment": bool(species),
        "remove_organelle_phyloseq": bool(remove_organelle_phyloseq),
    }
    if dada2_trim_left is not None:
        config["dada2_trim_left"] = ",".join(str(v) for v in dada2_trim_left)
    if dada2_trim_right is not None:
        config["dada2_trim_right"] = ",".join(str(v) for v in dada2_trim_right)

    if asv_length_min is not None and asv_length_max is not None:
        config["asv_length_min"] = int(asv_length_min)
        config["asv_length_max"] = int(asv_length_max)
    elif asv_length_tolerance is not None:
        config["asv_length_min"] = max(1, int(amplen) - int(asv_length_tolerance))
        config["asv_length_max"] = int(amplen) + int(asv_length_tolerance)

    config_path = os.path.join(output_dir, "config.yaml")
    with open(config_path, "w") as f:
        yaml.dump(config, f)

    return config_path

def run_snakemake(config_path, is_quiet=False, until=None, cores="all"):
    conda_bin_dir = os.path.join(os.environ['CONDA_PREFIX'], 'bin')
    local_snakefile_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'snakefile.short')
    snakefile_path = local_snakefile_path if os.path.exists(local_snakefile_path) else os.path.join(conda_bin_dir, 'snakefile.short')

    print(f"Search Snakefile in: {snakefile_path}")
    if not os.path.exists(snakefile_path):
        print(f"ERROR: snakefile.short not found in {conda_bin_dir}")
        sys.exit(1)

    args = [
        "snakemake",
        "--configfile", config_path,
        "--cores", str(cores),
        "--nolock",
        "--show-failed-logs",
        "--snakefile", snakefile_path
    ]

    if is_quiet:
        args += ["--quiet", "all"]

    if until!=None:
        args += ["--until", until]

    print("Let's Go:", " ".join(args))

    progress_pattern = re.compile(r"(?P<done>\d+)\s+of\s+(?P<total>\d+)\s+steps")

    def render_progress(done, total):
        width = 28
        ratio = 0 if total <= 0 else max(0.0, min(1.0, done / total))
        filled = int(round(width * ratio))
        bar = "#" * filled + "-" * (width - filled)
        return f"[{bar}] {ratio * 100:5.1f}% ({done}/{total})"

    try:
        if is_quiet:
            subprocess.run(args, check=True)
            return

        process = subprocess.Popen(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )

        last_progress = None
        is_tty = sys.stdout.isatty()
        assert process.stdout is not None
        for line in process.stdout:
            match = progress_pattern.search(line)
            if match:
                done = int(match.group("done"))
                total = int(match.group("total"))
                progress_line = render_progress(done, total)
                last_progress = progress_line
                if is_tty:
                    print(f"\r{progress_line}", end="", flush=True)
                else:
                    print(progress_line)
                continue

            if is_tty and last_progress is not None:
                print()
                last_progress = None
            print(line, end="")

        return_code = process.wait()
        if is_tty and last_progress is not None:
            print()
        if return_code != 0:
            raise subprocess.CalledProcessError(return_code, args)
    except subprocess.CalledProcessError as e:
        print(f"ERROR in Snakemake: {e}")
        sys.exit(1)

def merge_multiple_runs(run_output_dirs, config_path, final_output_dir):
    subprocess.run([
    "snakemake",
    "--snakefile", "snakefile.short",
    "--configfile", f"{config_path}",
    "--config",
    f"output_dir={final_output_dir}",
    f"run_dirs={' '.join(run_output_dirs)}"
    ])



