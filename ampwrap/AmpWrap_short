    print_banner()

    parser = argparse.ArgumentParser(
        description=(
            "ampwrap short: process paired-end Illumina amplicon reads and assign taxonomy.\n\n"
            "Supported input naming:\n"
            "  Custom:    sample_R1.fastq.gz / sample_R2.fastq.gz\n"
            "  Illumina:  sample_S1_L001_R1_001.fastq.gz / sample_S1_L001_R2_001.fastq.gz"
        ),
        prog=f"ampwrap short ({load_ampwrap_version()})",
        formatter_class=ReadableHelpFormatter,
        epilog=(
            "Examples:\n"
            "  ampwrap short -i reads_dir -a FORWARD -A REVERSE -l 372\n"
            "  ampwrap short -i run1 run2 -a FORWARD -A REVERSE -l 372 --trim-primers-dada2\n"
            "  ampwrap short -i reads_dir -a FORWARD -A REVERSE \\\n"
            "    --dada2_params 'truncLen=c(240,200);maxEE=c(2,2)'\n"
            "  ampwrap short -i reads_dir -a FORWARD -A REVERSE -l 372 \\\n"
            "    --loess_model auto --max-reads-per-sample 200000 --cores 4"
        ),
    )
    required = parser.add_argument_group("required arguments")
    required.add_argument(
        "-i", "--input_directory", nargs="+",
        help=(
            "Input directory with raw FASTQ files.\n"
            "Provide multiple paths for multiple runs, for example:\n"
            "  -i path/to/run1 path/to/run2 path/to/run3"
        ),
    )
    required.add_argument("-a", "--forward_primer",  help="Forward primer sequence")
    required.add_argument("-A", "--reverse_primer",  help="Reverse primer sequence")

    general = parser.add_argument_group("general options")
    general.add_argument("-o", "--output_directory", default=default_short_output_dir(), help="Output directory")
    general.add_argument(
        "--db-dir",
        default=default_db_dir(),
        help=(
            "Directory that stores downloaded taxonomy databases.\n"
            "Defaults to AMPWRAP_DB_DIR if set, otherwise ~/.ampwrap/db."
        ),
    )
    general.add_argument(
        "-d", "--db_choice", default="dada2_silva_genus138",
        help="Database for taxonomy assignment.\nChoices:\n" + "\n".join(f"  - {choice}" for choice in DB_CHOICES),
    )
    general.add_argument(
        "--species",
        action="store_true",
        help=(
            "Add optional 16S species-level assignments with DADA2 addSpecies.\n"
            "Supported only for dada2_silva_genus138 and dada2_RDP_genus19."
        ),
    )
    general.add_argument(
        "--remove-organelle-phyloseq",
        action="store_true",
        help=(
            "Save an additional phyloseq object filtered for chloroplast and mitochondria taxa.\n"
            "The original phyloseq object is always retained."
        ),
    )
    general.add_argument("-q", "--quiet", action="store_true", help="Minimal standard output")
    general.add_argument("--db-info", action="store_true", help="Show available databases and exit")
    general.add_argument(
        "--bigdata", action="store_true",
        help=(
            "Apply safer defaults for very deep datasets.\n"
            "Enables the sample-wise streaming DADA2 inference path and limits cores if not specified."
        ),
    )

    denoising = parser.add_argument_group("denoising and trimming")
    denoising.add_argument(
        "-l", "--amplen", type=int,
        help=(
            "Amplicon length excluding primers.\n"
            "Required unless --dada2_params provides explicit truncLen and maxEE.\n"
            "Example: R926 - F515 = 411; pF19 - pR20 = 372"
        ),
    )
    denoising.add_argument(
        "--trim-primers-dada2",
        action="store_true",
        help=(
            "Trim primers during DADA2 filtering using trimLeft/trimRight.\n"
            "Defaults to primer lengths for trimLeft and 0,0 for trimRight."
        ),
    )
    denoising.add_argument(
        "--dada2-trim-left",
        type=lambda value: parse_trim_pair(value, "--dada2-trim-left"),
        help="Comma-separated trimLeft values for forward and reverse reads, e.g. 19,20.",
    )
    denoising.add_argument(
        "--dada2-trim-right",
        type=lambda value: parse_trim_pair(value, "--dada2-trim-right"),
        help="Comma-separated trimRight values for forward and reverse reads, e.g. 0,0.",
    )
    denoising.add_argument("--cutadapt_trim_by_length", help=argparse.SUPPRESS, action="store_true", default=False)
    denoising.add_argument("--cutadapt_disable_discard_untrimmed",help="Disable cutadapt --discard-untrimmed",action="store_true",default=False)
    denoising.add_argument(
        "--dada2_params", type=str,
        help=(
            "Semicolon-separated DADA2 parameters that bypass Figaro.\n"
            "Required keys: truncLen and maxEE.\n"
            "Example: 'truncLen=c(240,200);maxEE=c(2,2)'"
        ),
    )
    denoising.add_argument("--dry-run-tune", action="store_true", help="Run only Figaro tuning, show first 5 results, then clean up")
    denoising.add_argument(
        "--loess_model", type=str, choices=["auto", "vanilla", "1", "2", "3", "4"], default="auto",
        help=(
            "DADA2 error-learning mode.\n"
            "'auto' detects binned qualities and selects one shared model for forward/reverse.\n"
            "'vanilla' keeps standard DADA2."
        ),
    )
    denoising.add_argument(
        "--max-reads-per-sample", type=parse_max_reads,
        help=(
            "Cap reads per sample before QC/trimming.\n"
            "Use an integer for a fixed cap."
        ),
    )
    denoising.add_argument(
        "--asv-length",
        type=parse_asv_length_spec,
        help=(
            "ASV length filter applied after chimera removal.\n"
            "Use 'auto' to keep ASVs around the dominant observed length, or MIN:MAX for an explicit range."
        ),
    )
    denoising.add_argument(
        "--asv-length-tolerance", type=parse_asv_length_tolerance,
        help=argparse.SUPPRESS,
    )
    denoising.add_argument(
        "--asv-length-min",
        type=lambda value: parse_nonnegative_int(value, "--asv-length-min"),
        help=argparse.SUPPRESS,
    )
    denoising.add_argument(
        "--asv-length-max",
        type=lambda value: parse_nonnegative_int(value, "--asv-length-max"),
        help=argparse.SUPPRESS,
    )

    execution = parser.add_argument_group("execution")
    execution.add_argument("-c", "--cores", type=parse_cores, default="all", help="Limit Snakemake cores")
    execution.add_argument(
        "--resource-profile",
        type=parse_resource_profile,
        default="balanced",
        help="Per-step CPU profile: safe, balanced, or aggressive.",
    )

    args = parser.parse_args()

    if args.db_info:
        print_db_table()
        sys.exit(0)
    if not args.input_directory or not args.forward_primer or not args.reverse_primer:
        parser.print_usage()
        print("\nError: -i, -a and -A are required unless --db-info is used.")
        sys.exit(1)

    check_special_primers(args.forward_primer, args.reverse_primer)
    input_dirs = args.input_directory
    all_run_outputs = []
    output_dir = args.output_directory
    is_quiet = args.quiet
    disable_discard_untrimmed = args.cutadapt_disable_discard_untrimmed
    dry_run_tune = args.dry_run_tune
    cores = args.cores

    if args.bigdata:
        if cores == "all":
            cores = 4
        print(f"INFO: --bigdata enabled, using cores={cores}")

    try:
        dada2_params = validate_dada2_params(args.dada2_params)
    except ValueError as exc:
        print(f"ERROR: {exc}")
        sys.exit(1)
    use_custom_dada2 = bool(dada2_params)

    if args.cutadapt_trim_by_length:
        print(
            "ERROR: --cutadapt_trim_by_length has been deprecated.\n"
            "Use --trim-primers-dada2 to trim primers with DADA2 trimLeft/trimRight instead."
        )
        sys.exit(1)

    trim_primers_dada2 = args.trim_primers_dada2 or args.dada2_trim_left is not None or args.dada2_trim_right is not None
    dada2_trim_left = args.dada2_trim_left
    dada2_trim_right = args.dada2_trim_right
    if trim_primers_dada2:
        if dada2_trim_left is None:
            dada2_trim_left = (len(args.forward_primer), len(args.reverse_primer))
        if dada2_trim_right is None:
            dada2_trim_right = (0, 0)

    asv_length_mode = "off"
    asv_length_min = None
    asv_length_max = None
    if args.asv_length is not None and (
        args.asv_length_tolerance is not None or args.asv_length_min is not None or args.asv_length_max is not None
    ):
        print("ERROR: use either --asv-length or the legacy ASV length options, not both.")
        sys.exit(1)

    if args.asv_length is not None:
        asv_length_mode, parsed_min, parsed_max = args.asv_length
        asv_length_min = parsed_min
        asv_length_max = parsed_max
    elif args.asv_length_tolerance is not None:
        asv_length_mode = "range"
        asv_length_min = max(1, int(args.amplen) - int(args.asv_length_tolerance))
        asv_length_max = int(args.amplen) + int(args.asv_length_tolerance)
    elif args.asv_length_min is not None or args.asv_length_max is not None:
        if (args.asv_length_min is None) ^ (args.asv_length_max is None):
            print("ERROR: --asv-length-min and --asv-length-max must be provided together.")
            sys.exit(1)
        if args.asv_length_min > args.asv_length_max:
            print("ERROR: --asv-length-min cannot be greater than --asv-length-max.")
            sys.exit(1)
        asv_length_mode = "range"
        asv_length_min = args.asv_length_min
        asv_length_max = args.asv_length_max

    if not use_custom_dada2 and args.amplen is None:
        print("ERROR: -l/--amplen is required unless --dada2_params provides explicit truncLen/maxEE.")
        sys.exit(1)

    if args.species and args.db_choice not in SPECIES_SUPPORTED_DB_CHOICES:
        print(
            "ERROR: --species is currently supported only for "
            "dada2_silva_genus138 and dada2_RDP_genus19."
        )
        sys.exit(1)

    if len(input_dirs) > 1 and not trim_primers_dada2:
        print(
            Fore.YELLOW
            + (
                "\nMULTIRUN NOTICE:\n"
                "Consistent primer trimming is strongly recommended for multiple runs because ASVs are merged by final sequence.\n"
                "Differences in DADA2 truncation can be acceptable if the amplicon still merges correctly, but inconsistent primer removal is not.\n"
                "Recommended option: --trim-primers-dada2\n"
            )
            + Style.RESET_ALL
        )

    # if it is dry-run,new temp directory
    temp_output_dir = None
    if dry_run_tune:
        import tempfile
        temp_output_dir = tempfile.mkdtemp(prefix="ampwrap_dryrun_")
        print(f"Dry-run mode: using temporary directory {temp_output_dir}")
        original_output_dir = output_dir
        output_dir = temp_output_dir

    os.makedirs(output_dir, exist_ok=True)

    file_patterns = ["*.fq", "*.fq.gz", "*.fastq", "*.fastq.gz"]


    metainfo = []
    seen_run_names = set()

    for input_dir in input_dirs:
        print(f"\n🔹 Processing run: {input_dir}")

        run_name = ensure_unique_run_name(sanitize_run_name(input_dir), seen_run_names)
        run_output_dir = output_dir
        os.makedirs(run_output_dir, exist_ok=True)

        # search  fastq/fq.gz
        file_patterns = ["*.fq", "*.fq.gz", "*.fastq", "*.fastq.gz"]
        files = [
            file
            for pattern in file_patterns
            for file in glob.glob(os.path.join(input_dir, pattern))
            if re.search(r"_[Rr][12](?:_|\.)", file)
        ]
        if not files:
            print(
                f"ERROR: No FASTQ files with recognizable read suffixes were found in '{input_dir}'. "
                "Expected paired-end names containing '_R1'/'_R2', for example "
                "'sample_R1.fastq.gz' and 'sample_R2.fastq.gz' or Illumina-style "
                "'sample_S1_L001_R1_001.fastq.gz'."
            )
            sys.exit(1)

        extension = '.'.join(os.path.basename(files[0]).split('.')[1:])

        figaro_name = None
        parsed_run_files = None
        parser_errors = []
        for fxn in (IlluminaStandard, FVieiraStandard):
                try:
                        parsed_run_files = [fxn(f) for f in files]
                except ValueError as exc:
                        parser_errors.append(f"{fxn.__name__}: {exc}")
                        continue
                else:
                        figaro_name = fxn.__name__
                        break

        if not parsed_run_files:
            print(
                f"ERROR: Files in '{input_dir}' do not follow a supported paired-end naming convention.\n"
                "Supported examples:\n"
                "  - Custom: sample_R1.fastq.gz / sample_R2.fastq.gz\n"
                "  - Illumina: sample_S1_L001_R1_001.fastq.gz / sample_S1_L001_R2_001.fastq.gz\n"
                f"Parser details: {' | '.join(parser_errors) if parser_errors else 'no parser matched'}"
            )
            sys.exit(1)

        try:
            validate_paired_samples(parsed_run_files, input_dir)
        except ValueError as exc:
            print(f"ERROR: {exc}")
            sys.exit(1)

        metainfo.extend([(*record, run_name, figaro_name) for record in parsed_run_files])

    sample_tab_path = os.path.join(run_output_dir, "sample.tab")
    with open(sample_tab_path, "w") as sf:
        for t in metainfo:
            file_path, fileName, sample, direction, run_name, parser_name = t
            file_path = os.path.abspath(file_path)
            sf.write(f"{sample} {direction} {file_path} {parser_name} {run_name}\n")

    config_path = write_config_yaml(
                input_dir=input_dir,
                output_dir=run_output_dir,
                forward_primer=args.forward_primer,
                reverse_primer=args.reverse_primer,
                amplen=args.amplen,
                db_choice=args.db_choice,
                metainfo=metainfo,
                extension=extension,
                figaro_name=figaro_name,
                trim_primers_dada2=trim_primers_dada2,
                disable_discard_untrimmed=disable_discard_untrimmed,
                dry_run_tune=dry_run_tune,
                dada2_params=dada2_params,
                threads=cores,
                loess_model=args.loess_model,
                max_reads_per_sample=args.max_reads_per_sample,
                db_dir=args.db_dir,
                asv_length_mode=asv_length_mode,
                asv_length_tolerance=args.asv_length_tolerance,
                asv_length_min=asv_length_min,
                asv_length_max=asv_length_max,
                bigdata_mode=args.bigdata,
                dada2_trim_left=dada2_trim_left,
                dada2_trim_right=dada2_trim_right,
                resource_profile=args.resource_profile,
                species=args.species,
                remove_organelle_phyloseq=args.remove_organelle_phyloseq)
    run_snakemake(config_path, is_quiet, cores=cores)


if __name__ == "__main__":
    main()
