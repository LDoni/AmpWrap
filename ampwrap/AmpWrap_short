def FVieiraStandard(file_):
    fileName = os.path.basename(file_)
    basename = fileName.split(".")[0]
    try:
        sample, direction = basename.split("_")
        direction = direction.replace("R", "").replace("r", "")
        direction = int(direction)
    except ValueError:
        raise ValueError(
            f"{fileName} does not appear to be a valid file for this standard. Please check file naming convention."
        )
    return file_, fileName, sample, direction

def IlluminaStandard(file_):
    fileName = os.path.basename(file_)
    try:
        baseName = fileName.split(".")[0]
        baseSplit = baseName.split("_")
        group = "_".join(baseSplit[:-4])
        sample = baseSplit[-5]
        direction = int(baseSplit[-2].replace("R", ""))
    except (ValueError, IndexError):
        raise ValueError(
            f"{fileName} does not appear to be a valid Illumina file name. Please check file naming convention."
        )
    return file_, fileName, sample, direction

def parse_cores(value):
    if isinstance(value, int):
        if value < 1:
            raise argparse.ArgumentTypeError("--cores must be >= 1")
        return value

    lowered = str(value).strip().lower()
    if lowered == "all":
        return "all"

    try:
        parsed = int(lowered)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("--cores must be a positive integer or 'all'") from exc

    if parsed < 1:
        raise argparse.ArgumentTypeError("--cores must be >= 1")
    return parsed


def parse_positive_int(value, option_name):
    try:
        parsed = int(str(value).strip())
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"{option_name} must be a positive integer") from exc
    if parsed < 1:
        raise argparse.ArgumentTypeError(f"{option_name} must be >= 1")
    return parsed


def parse_max_reads(value):
    lowered = str(value).strip().lower()
    if lowered == "auto":
        return "auto"
    return parse_positive_int(value, "--max-reads-per-sample")


def parse_asv_length_tolerance(value):
    return parse_positive_int(value, "--asv-length-tolerance")


def default_db_dir():
    env_value = os.environ.get("AMPWRAP_DB_DIR")
    if env_value:
        return env_value

    script_dir = os.path.dirname(os.path.abspath(__file__))
    repo_db_dir = os.path.join(script_dir, "db_s")
    if os.path.isdir(repo_db_dir):
        return repo_db_dir

    return os.path.join(os.getcwd(), "db_s")


def sanitize_run_name(path):
    base_name = os.path.basename(os.path.normpath(path))
    sanitized = re.sub(r"[^A-Za-z0-9._-]+", "_", base_name).strip("._-")
    return sanitized or "run"


def ensure_unique_run_name(candidate, seen_names):
    if candidate not in seen_names:
        seen_names.add(candidate)
        return candidate

    counter = 2
    while f"{candidate}_{counter}" in seen_names:
        counter += 1
    unique_name = f"{candidate}_{counter}"
    seen_names.add(unique_name)
    return unique_name


def validate_dada2_params(raw_params):
    if not raw_params:
        return None

    cleaned = raw_params.strip()
    if not cleaned:
        return None

    parsed = {}
    for chunk in [p.strip() for p in cleaned.split(";") if p.strip()]:
        if "=" not in chunk:
            raise ValueError(
                f"Invalid --dada2_params entry '{chunk}'. Use key=value pairs separated by ';', "
                "for example 'truncLen=c(240,200);maxEE=c(2,2)'."
            )
        key, value = chunk.split("=", 1)
        parsed[key.strip()] = value.strip()

    missing = [key for key in ("truncLen", "maxEE") if key not in parsed]
    if missing:
        raise ValueError(
            "When --dada2_params is used, both truncLen and maxEE must be provided. "
            f"Missing: {', '.join(missing)}."
        )
    return cleaned


def validate_paired_samples(parsed_files, input_dir):
    sample_to_directions = {}
    for _, _, sample, direction in parsed_files:
        sample_to_directions.setdefault(sample, set()).add(direction)

    invalid = {
        sample: sorted(directions)
        for sample, directions in sample_to_directions.items()
        if directions != {1, 2}
    }
    if invalid:
        details = "; ".join(
            f"{sample} has directions {dirs}" for sample, dirs in sorted(invalid.items())
        )
        raise ValueError(
            f"Input directory '{input_dir}' does not contain valid paired-end files for all samples: {details}. "
            "Each sample must have exactly one R1 file and one R2 file."
        )


def write_config_yaml(input_dir, output_dir, forward_primer, reverse_primer, amplen, db_choice,
metainfo, extension, figaro_name, cutadapt_trim_by_length, disable_discard_untrimmed, dry_run_tune,
dada2_params=None, threads=None, loess_model=None, max_reads_per_sample=None, db_dir=None,
asv_length_tolerance=None, bigdata_mode=False):
    config = {
        "input_dir": input_dir,
        "output_dir": output_dir,
        "forward_primer": forward_primer,
        "reverse_primer": reverse_primer,
        "amplicon_length": amplen,
        "assign_taxonomy_method": db_choice,
        "sample_tab": os.path.join(output_dir, "sample.tab"),
        "db_dir": db_dir if db_dir else default_db_dir(),
        "read": [1, 2],
        "sample": [f[1].split(".")[0] for f in metainfo],
        "script": "script",
        "logs": os.path.join(output_dir, "logs"),
        "file_extension": extension,
        "figaro_name": figaro_name,
        "dada2_params": dada2_params if dada2_params else "",
        "loess_model": loess_model if loess_model else "auto",
        "analysis_start": datetime.datetime.now().isoformat(timespec="seconds"),
        "dada2_source": "user" if dada2_params else "figaro",
        "max_reads_per_sample": max_reads_per_sample if max_reads_per_sample else 0,
        "cutadapt_trim_by_length": cutadapt_trim_by_length,
        "disable_discard_untrimmed": disable_discard_untrimmed,
        "dry_run_tune": dry_run_tune,
        "threads": threads if threads not in (None, "all") else os.cpu_count(),
        "bigdata_mode": bool(bigdata_mode)
    }
    if asv_length_tolerance is not None:
        config["asv_length_min"] = max(1, int(amplen) - int(asv_length_tolerance))
        config["asv_length_max"] = int(amplen) + int(asv_length_tolerance)

    config_path = os.path.join(output_dir, "config.yaml")
    with open(config_path, "w") as f:
        yaml.dump(config, f)

    return config_path

def run_snakemake(config_path, is_quiet=False, until=None, cores="all"):
    conda_bin_dir = os.path.join(os.environ['CONDA_PREFIX'], 'bin')
    local_snakefile_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'snakefile.short')
    snakefile_path = local_snakefile_path if os.path.exists(local_snakefile_path) else os.path.join(conda_bin_dir, 'snakefile.short')

    print(f"Search Snakefile in: {snakefile_path}")
    if not os.path.exists(snakefile_path):
        print(f"ERROR: snakefile.short not found in {conda_bin_dir}")
        sys.exit(1)

    args = [
        "snakemake",
        "--configfile", config_path,
        "--cores", str(cores),
        "--nolock",
        "--show-failed-logs",
        "--snakefile", snakefile_path
    ]

    if is_quiet:
        args += ["--quiet", "all"]

    if until!=None:
        args += ["--until", until]

    print("Let's Go:", " ".join(args))

    try:
        subprocess.run(args, check=True)
    except subprocess.CalledProcessError as e:
        print(f"ERROR in Snakemake: {e}")
        sys.exit(1)

def merge_multiple_runs(run_output_dirs, config_path, final_output_dir):
    subprocess.run([
    "snakemake",
    "--snakefile", "snakefile.short",
    "--configfile", f"{config_path}",
    "--config",
    f"output_dir={final_output_dir}",
    f"run_dirs={' '.join(run_output_dirs)}"
    ])



def main():
    print_banner()

    parser = argparse.ArgumentParser(
        description=(
            "ampwrap short: process paired-end Illumina amplicon reads and assign taxonomy.\n\n"
            "Supported input naming:\n"
            "  Custom:    sample_R1.fastq.gz / sample_R2.fastq.gz\n"
            "  Illumina:  sample_S1_L001_R1_001.fastq.gz / sample_S1_L001_R2_001.fastq.gz"
        ),
        formatter_class=ReadableHelpFormatter,
        epilog=(
            "Examples:\n"
            "  ampwrap short -i reads_dir -a FORWARD -A REVERSE -l 372\n"
            "  ampwrap short -i run1 run2 -a FORWARD -A REVERSE -l 372 --cutadapt_trim_by_length\n"
            "  ampwrap short -i reads_dir -a FORWARD -A REVERSE \\\n"
            "    --dada2_params 'truncLen=c(240,200);maxEE=c(2,2)'\n"
            "  ampwrap short -i reads_dir -a FORWARD -A REVERSE -l 372 \\\n"
            "    --loess_model auto --max-reads-per-sample auto --cores 4"
        ),
    )
    required = parser.add_argument_group("required arguments")
    required.add_argument(
        "-i", "--input_directory", nargs="+",
        help=(
            "Input directory with raw FASTQ files.\n"
            "Provide multiple paths for multiple runs, for example:\n"
            "  -i path/to/run1 path/to/run2 path/to/run3"
        ),
    )
    required.add_argument("-a", "--forward_primer",  help="Forward primer sequence")
    required.add_argument("-A", "--reverse_primer",  help="Reverse primer sequence")

    general = parser.add_argument_group("general options")
    general.add_argument("-o", "--output_directory", default=os.path.join(os.getcwd(), "ampwrap_short"), help="Output directory")
    general.add_argument(
        "--db-dir",
        default=default_db_dir(),
        help=(
            "Directory that stores downloaded taxonomy databases.\n"
            "Defaults to AMPWRAP_DB_DIR if set, otherwise the local ampwrap/db_s directory."
        ),
    )
    general.add_argument(
        "-d", "--db_choice", default="dada2_silva_genus138",
        help="Database for taxonomy assignment.\nChoices:\n" + "\n".join(f"  - {choice}" for choice in DB_CHOICES),
    )
    general.add_argument("-q", "--quiet", action="store_true", help="Minimal standard output")
    general.add_argument("--db-info", action="store_true", help="Show available databases and exit")
    general.add_argument(
        "--bigdata", action="store_true",
        help="Apply safer defaults for very deep datasets (currently enables auto read-cap and limits cores if not specified).",
    )

    denoising = parser.add_argument_group("denoising and trimming")
    denoising.add_argument(
        "-l", "--amplen", type=int,
        help=(
            "Amplicon length excluding primers.\n"
            "Required unless --dada2_params provides explicit truncLen and maxEE.\n"
            "Example: R926 - F515 = 411; pF19 - pR20 = 372"
        ),
    )
    denoising.add_argument("--cutadapt_trim_by_length",help="Trim primers by their declared length",action="store_true",default=False)
    denoising.add_argument("--cutadapt_disable_discard_untrimmed",help="Disable cutadapt --discard-untrimmed",action="store_true",default=False)
    denoising.add_argument(
        "--dada2_params", type=str,
        help=(
            "Semicolon-separated DADA2 parameters that bypass Figaro.\n"
            "Required keys: truncLen and maxEE.\n"
            "Example: 'truncLen=c(240,200);maxEE=c(2,2)'"
        ),
    )
    denoising.add_argument("--dry-run-tune", action="store_true", help="Run only Figaro tuning, show first 5 results, then clean up")
    denoising.add_argument(
        "--loess_model", type=str, choices=["auto", "vanilla", "1", "2", "3", "4"], default="auto",
        help=(
            "DADA2 error-learning mode.\n"
            "'auto' detects binned qualities and selects one shared model for forward/reverse.\n"
            "'vanilla' keeps standard DADA2."
        ),
    )
    denoising.add_argument(
        "--max-reads-per-sample", type=parse_max_reads,
        help=(
            "Cap reads per sample before QC/trimming.\n"
            "Use an integer for a fixed cap or 'auto' for plateau-based selection on deep libraries."
        ),
    )
    denoising.add_argument(
        "--asv-length-tolerance", type=parse_asv_length_tolerance,
        help=(
            "Keep only merged ASVs within amplicon_length +/- tolerance.\n"
            "Useful when merged ASV lengths vary unexpectedly."
        ),
    )

    execution = parser.add_argument_group("execution")
    execution.add_argument("-c", "--cores", type=parse_cores, default="all", help="Limit Snakemake cores")

    args = parser.parse_args()

    if args.db_info:
        print_db_table()
        sys.exit(0)
    if not args.input_directory or not args.forward_primer or not args.reverse_primer:
        parser.print_usage()
        print("\nError: -i, -a and -A are required unless --db-info is used.")
        sys.exit(1)

    check_special_primers(args.forward_primer, args.reverse_primer)
    input_dirs = args.input_directory
    all_run_outputs = []
    output_dir = args.output_directory
    is_quiet = args.quiet
    disable_discard_untrimmed = args.cutadapt_disable_discard_untrimmed
    dry_run_tune = args.dry_run_tune
    cutadapt_trim_by_length = args.cutadapt_trim_by_length
    cores = args.cores

    if args.bigdata:
        if args.max_reads_per_sample is None:
            args.max_reads_per_sample = "auto"
        if cores == "all":
            cores = 4
        print(f"INFO: --bigdata enabled, using max_reads_per_sample={args.max_reads_per_sample} and cores={cores}")

    try:
        dada2_params = validate_dada2_params(args.dada2_params)
    except ValueError as exc:
        print(f"ERROR: {exc}")
        sys.exit(1)
    use_custom_dada2 = bool(dada2_params)

    if not use_custom_dada2 and args.amplen is None:
        print("ERROR: -l/--amplen is required unless --dada2_params provides explicit truncLen/maxEE.")
        sys.exit(1)

    # if it is dry-run,new temp directory
    temp_output_dir = None
    if dry_run_tune:
        import tempfile
        temp_output_dir = tempfile.mkdtemp(prefix="ampwrap_dryrun_")
        print(f"Dry-run mode: using temporary directory {temp_output_dir}")
        original_output_dir = output_dir
        output_dir = temp_output_dir

    os.makedirs(output_dir, exist_ok=True)

    file_patterns = ["*.fq", "*.fq.gz", "*.fastq", "*.fastq.gz"]


    metainfo = []
    seen_run_names = set()

    for input_dir in input_dirs:
        print(f"\n🔹 Processing run: {input_dir}")

        run_name = ensure_unique_run_name(sanitize_run_name(input_dir), seen_run_names)
        run_output_dir = output_dir
        os.makedirs(run_output_dir, exist_ok=True)

        # search  fastq/fq.gz
        file_patterns = ["*.fq", "*.fq.gz", "*.fastq", "*.fastq.gz"]
        files = [
            file
            for pattern in file_patterns
            for file in glob.glob(os.path.join(input_dir, pattern))
            if re.search(r"_[Rr][12](?:_|\.)", file)
        ]
        if not files:
            print(
                f"ERROR: No FASTQ files with recognizable read suffixes were found in '{input_dir}'. "
                "Expected paired-end names containing '_R1'/'_R2', for example "
                "'sample_R1.fastq.gz' and 'sample_R2.fastq.gz' or Illumina-style "
                "'sample_S1_L001_R1_001.fastq.gz'."
            )
            sys.exit(1)

        extension = '.'.join(os.path.basename(files[0]).split('.')[1:])

        figaro_name = None
        parsed_run_files = None
        parser_errors = []
        for fxn in (IlluminaStandard, FVieiraStandard):
                try:
                        parsed_run_files = [fxn(f) for f in files]
                except ValueError as exc:
                        parser_errors.append(f"{fxn.__name__}: {exc}")
                        continue
                else:
                        figaro_name = fxn.__name__
                        break

        if not parsed_run_files:
            print(
                f"ERROR: Files in '{input_dir}' do not follow a supported paired-end naming convention.\n"
                "Supported examples:\n"
                "  - Custom: sample_R1.fastq.gz / sample_R2.fastq.gz\n"
                "  - Illumina: sample_S1_L001_R1_001.fastq.gz / sample_S1_L001_R2_001.fastq.gz\n"
                f"Parser details: {' | '.join(parser_errors) if parser_errors else 'no parser matched'}"
            )
            sys.exit(1)

        try:
            validate_paired_samples(parsed_run_files, input_dir)
        except ValueError as exc:
            print(f"ERROR: {exc}")
            sys.exit(1)

        metainfo.extend([(*record, run_name, figaro_name) for record in parsed_run_files])

    sample_tab_path = os.path.join(run_output_dir, "sample.tab")
    with open(sample_tab_path, "w") as sf:
        for t in metainfo:
            file_path, fileName, sample, direction, run_name, parser_name = t
            file_path = os.path.abspath(file_path)
            sf.write(f"{sample} {direction} {file_path} {parser_name} {run_name}\n")

    config_path = write_config_yaml(
                input_dir=input_dir,
                output_dir=run_output_dir,
