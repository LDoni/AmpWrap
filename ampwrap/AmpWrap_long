class ReadableHelpFormatter(argparse.ArgumentDefaultsHelpFormatter, argparse.RawTextHelpFormatter):
    pass


def load_ampwrap_version():
    version_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "VERSION")
    try:
        with open(version_path) as handle:
            return handle.read().strip()
    except OSError:
        return "unknown"


def strip_fastq_extension(path):
    return re.sub(r"\.(fastq|fq)(\.gz)?$", "", os.path.basename(path), flags=re.IGNORECASE)


def fastq_extension(path):
    match = re.search(r"\.((?:fastq|fq)(?:\.gz)?)$", os.path.basename(path), flags=re.IGNORECASE)
    if not match:
        raise ValueError(f"Unsupported FASTQ extension: {path}")
    return match.group(1).lower()


def parse_positive_int(value, option_name):
    try:
        parsed = int(str(value).strip())
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"{option_name} must be a positive integer") from exc
    if parsed < 1:
        raise argparse.ArgumentTypeError(f"{option_name} must be >= 1")
    return parsed


def parse_threads(value):
    return parse_positive_int(value, "--threads")


def parse_nl_min_len(value):
    return parse_positive_int(value, "--nl-min-len")


def parse_nl_max_len(value):
    return parse_positive_int(value, "--nl-max-len")


def parse_nl_min_qual(value):
    return parse_positive_int(value, "--nl-min-qual")


def default_long_db_dir():
    env_value = os.environ.get("AMPWRAP_LONG_DB_DIR")
    if env_value:
        return env_value
    root_value = os.environ.get("AMPWRAP_DB_DIR")
    if root_value:
        return os.path.join(root_value, "emu")
    return os.path.join(os.path.expanduser("~"), ".ampwrap", "db", "emu")


def default_long_output_dir():
    from datetime import datetime
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    return os.path.join(os.getcwd(), f"ampwrap_long_{timestamp}")


