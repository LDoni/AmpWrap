def write_config_yaml(input_dir, output_dir, db_choice, extension, sample_names, trimming, threads, nl_min_len, nl_max_len, nl_min_qual,
                      emu_min_ab, forward_primer, reverse_primer, chimera, keep_counts, db_dir):
    config = {
        "input_dir": input_dir,
        "output_dir": output_dir,
        "tax_db": db_choice,
        "db_dir": db_dir,
        "script": "script",
        "logs": os.path.join(output_dir, "logs"),
        "file_extension": extension,
        "sample_names": sample_names,
        "threads": threads,
        "nl_min_len": nl_min_len,
        "nl_max_len": nl_max_len,
        "nl_min_qual": nl_min_qual,
        "emu_min_ab": emu_min_ab,
        "forward_primer": forward_primer,
        "reverse_primer": reverse_primer,
        "keep_counts": keep_counts,
    }

    if trimming != None: config["trimming_method"] = trimming
    if chimera : config["chimera"] = True

    config_path = os.path.join(output_dir, "config.yaml")
    with open(config_path, "w") as f:
        yaml.dump(config, f)
    return config_path


def run_snakemake(config_path, cores, is_quiet=False):
    import os
    import subprocess
    import sys

    conda_bin_dir = os.path.join(os.environ.get("CONDA_PREFIX", sys.prefix), "bin")
    local_snakefile_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "snakefile.long")
    snakefile_path = (
        local_snakefile_path
        if os.path.exists(local_snakefile_path)
        else os.path.join(conda_bin_dir, "snakefile.long")
    )
    print(f"Searching Snakefile in: {snakefile_path}")
    if not os.path.exists(snakefile_path):
        print(f"ERROR: snakefile.long not found in {conda_bin_dir}")
        print("Check the paths:")
        print(f"  ls {conda_bin_dir} | grep snakefile.long")
        sys.exit(1)

    args = [
        "snakemake",
        "--configfile", config_path,
        "--cores", str(cores),
        "--nolock",
        "--show-failed-logs",
        "--snakefile", snakefile_path
    ]

    if is_quiet:
        args += ["--quiet", "all"]

    print("Let's Go:", " ".join(args))

    try:
        subprocess.run(args, check=True)
    except subprocess.CalledProcessError as e:
        print(f"ERROR in Snakemake: {e}")
        sys.exit(1)

def print_db_info():
    print("Choice\tDatabase Name\tVersion\tFile Name\tMD5")
    for choice, db in LONG_DATABASES.items():
        print(f"{choice}\t{db['name']}\t{db['version']}\t{db['file']}\t{db['md5']}")











def main():
    print_banner()

    parser = argparse.ArgumentParser(
        description="ampwrap long: process Nanopore amplicon reads and assign taxonomy with EMU.",
        prog=f"ampwrap long ({load_ampwrap_version()})",
        formatter_class=ReadableHelpFormatter,
        epilog=(
            "Examples:\n"
            "  ampwrap long -i fastq_dir\n"
            "  ampwrap long -i fastq_dir -tr porechop --cutadapt-forward FORWARD --cutadapt-reverse REVERSE\n"
            "  ampwrap long -i fastq_dir -d silva --db-dir /path/to/shared_emu_db -t 8"
        ),
    )

    required = parser.add_argument_group("required arguments")
    required.add_argument(
        "-i", "--input-directory",
        help="Input directory containing Nanopore FASTQ files (.fq/.fastq, optionally .gz).",
    )

    general = parser.add_argument_group("general options")
    general.add_argument(
        "-o", "--output-directory",
        default=default_long_output_dir(),
        help="Output directory.",
    )
    general.add_argument(
        "-d", "--db-choice",
        choices=list(LONG_DATABASES),
        default="emu",
        help="EMU database to use for taxonomy assignment.",
    )
    general.add_argument(
        "--db-dir",
        default=default_long_db_dir(),
        help="Directory that stores EMU databases. Defaults to AMPWRAP_LONG_DB_DIR, AMPWRAP_DB_DIR/emu, or ~/.ampwrap/db/emu.",
    )
    general.add_argument("-q", "--quiet", action="store_true", help="Minimal standard output")
    general.add_argument("--db-info", action="store_true", help="Print available databases with version and checksum info")

    processing = parser.add_argument_group("processing")
    processing.add_argument(
        "-tr", "--trimming",
        choices=["porechop", "porechop_abi"],
        default=None,
        help="Adapter trimming method. Leave unset to skip adapter trimming.",
    )
    processing.add_argument(
        "-t", "--threads",
        type=parse_threads,
        default=os.cpu_count(),
        help="Maximum threads and Snakemake cores.",
    )
    processing.add_argument("--nl-min-len", type=parse_nl_min_len, default=1200, help="NanoFilt minimum read length.")
    processing.add_argument("--nl-max-len", type=parse_nl_max_len, default=1800, help="NanoFilt maximum read length.")
    processing.add_argument("--nl-min-qual", type=parse_nl_min_qual, default=10, help="NanoFilt minimum average quality.")
    processing.add_argument(
        "--emu-min-ab",
        type=float,
        default=0.0001,
        help="EMU minimum relative abundance threshold; 0.01 means 1 percent.",
    )
    processing.add_argument(
        "--cutadapt-forward",
        help="Forward primer sequence for optional cutadapt trimming on long reads.",
    )
    processing.add_argument(
        "--cutadapt-reverse",
        help="Reverse primer sequence for optional cutadapt trimming on long reads.",
    )
    processing.add_argument("-c", "--chimera", action="store_true", help="Run yacrd-based chimera scrubbing after NanoFilt.")
    processing.add_argument("-kc", "--keep-counts", action="store_true", help="Include estimated read counts in EMU output.")
    args = parser.parse_args()

    if args.db_info:
        print_db_info()
        sys.exit(0)

    if not args.input_directory:
        parser.print_usage()
        print("\nError: -i is required unless --db-info is used.")
        sys.exit(1)

    if args.db_choice in {"silva-138.2", "unite-fungi", "unite-all"}:
        print(
            f"WARNING: The upstream EMU {args.db_choice} database is distributed with this notice: "
            "\"This database has not yet been tested or validated with Emu.\""
        )




    if len(sys.argv) == 1:
        parser.print_usage()
        sys.exit(0)


    input_dir = args.input_directory
    input_dir = os.path.abspath(os.path.expanduser(input_dir))
    output_dir = os.path.abspath(os.path.expanduser(args.output_directory))
    nl_min_len = args.nl_min_len
    nl_max_len = args.nl_max_len
    nl_min_qual = args.nl_min_qual
    emu_min_ab = args.emu_min_ab
    is_quiet = args.quiet
    reverse_primer = args.cutadapt_reverse
    forward_primer = args.cutadapt_forward
    keep_counts = args.keep_counts
    threads = args.threads

    if not os.path.isdir(input_dir):
        print(f"ERROR: Input directory does not exist: {input_dir}")
        sys.exit(1)
    if bool(forward_primer) != bool(reverse_primer):
        print("ERROR: --cutadapt-forward and --cutadapt-reverse must be provided together.")
        sys.exit(1)
    if not 0 <= emu_min_ab <= 1:
        print("ERROR: --emu-min-ab must be between 0 and 1.")
        sys.exit(1)

    # Create output directory if it doesn't exist
    os.makedirs(output_dir, exist_ok=True)





    file_patterns = ["*.fq", "*.fq.gz", "*.fastq", "*.fastq.gz"]
    files = []
    matched_patterns = []


    for pattern in file_patterns:
        matched_files = glob.glob(os.path.join(input_dir, pattern))
        if matched_files:
            files.extend(matched_files)
            matched_patterns.extend([pattern] * len(matched_files))


    if not files:
        print("No matching files found in the input directory.")
        sys.exit(1)



    files = sorted(files)
    extensions = {fastq_extension(file) for file in files}
    if len(extensions) != 1:
        print(
            "ERROR: Mixed FASTQ extensions are not supported in one long-read run. "
            f"Found: {', '.join(sorted(extensions))}"
        )
        sys.exit(1)
    extension = extensions.pop()
    sample_names = [strip_fastq_extension(file) for file in files]
    if len(sample_names) != len(set(sample_names)):
        print("ERROR: Duplicate sample names detected after stripping FASTQ extensions.")
        sys.exit(1)
    invalid_sample_names = [
        sample
        for sample in sample_names
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", sample)
    ]
    if invalid_sample_names:
        print(
            "ERROR: Long-read sample names may contain only letters, numbers, '.', '_' and '-', "
            "and must start with a letter or number. Invalid names: "
            + ", ".join(invalid_sample_names)
        )
        sys.exit(1)
    if args.nl_min_len > args.nl_max_len:
        print("ERROR: --nl-min-len must be <= --nl-max-len.")
        sys.exit(1)









    config_path = write_config_yaml(
        input_dir, output_dir, args.db_choice, extension, sample_names, args.trimming, threads, nl_min_len, nl_max_len, nl_min_qual,
        emu_min_ab, forward_primer, reverse_primer, args.chimera, keep_counts,
        os.path.abspath(os.path.expanduser(args.db_dir))
    )
    run_snakemake(config_path, threads, is_quiet=is_quiet)

if __name__ == "__main__":
    main()
