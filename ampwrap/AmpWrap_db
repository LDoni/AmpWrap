#!/usr/bin/env python3

import argparse
import csv
import os
import sys


def default_db_root():
    env_value = os.environ.get("AMPWRAP_DB_DIR")
    if env_value:
        return env_value
    return os.path.join(os.path.expanduser("~"), ".ampwrap", "db")


def manifest_path(db_root):
    return os.path.join(db_root, "manifest.tsv")


def read_manifest(path):
    if not os.path.exists(path):
        return []
    with open(path, newline="") as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


def print_rows(rows):
    if not rows:
        print("No databases recorded in the manifest.")
        return

    fields = ["category", "name", "filename", "md5", "local_path", "last_checked"]
    widths = {
        field: max(len(field), *(len(str(row.get(field, ""))) for row in rows))
        for field in fields
    }

    header = "  ".join(field.ljust(widths[field]) for field in fields)
    print(header)
    print("  ".join("-" * widths[field] for field in fields))
    for row in rows:
        print("  ".join(str(row.get(field, "")).ljust(widths[field]) for field in fields))


def main():
    parser = argparse.ArgumentParser(
        description="Inspect AmpWrap database cache metadata."
    )
    parser.add_argument(
        "--db-dir",
        default=default_db_root(),
        help="Database root directory. Defaults to AMPWRAP_DB_DIR or ~/.ampwrap/db.",
    )

    subparsers = parser.add_subparsers(dest="command")
    list_parser = subparsers.add_parser("list", help="List databases recorded in the manifest")
    list_parser.add_argument("--category", help="Optional category filter, e.g. dada2 or emu")

    args = parser.parse_args()
    if args.command != "list":
        parser.print_help()
        sys.exit(1)

    rows = read_manifest(manifest_path(args.db_dir))
    if args.category:
        rows = [row for row in rows if row.get("category") == args.category]
    print_rows(rows)


if __name__ == "__main__":
    main()
